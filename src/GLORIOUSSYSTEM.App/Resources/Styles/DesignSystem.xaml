<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- GLORIOUSSYSTEM shared visual language: dark glass / burgundy / gold -->
    <x:Double x:Key="PageHorizontalPadding">24</x:Double>
    <x:Double x:Key="PageVerticalPadding">24</x:Double>
    <x:Double x:Key="SectionSpacing">20</x:Double>
    <x:Double x:Key="CardSpacing">12</x:Double>
    <x:Double x:Key="ControlSpacing">8</x:Double>

    <x:Int32 x:Key="CardCornerRadius">16</x:Int32>
    <x:Int32 x:Key="SmallCornerRadius">12</x:Int32>
    <x:Int32 x:Key="PillCornerRadius">24</x:Int32>

    <Style x:Key="GSPageTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="CharacterSpacing" Value="-0.3" />
    </Style>
    <Style x:Key="GSPageSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>
    <Style x:Key="GSSectionTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="GSCardTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="GSBody" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="GSMuted" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="GSMetric" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- Glass surfaces: translucent-looking layered burgundy panels with luminous borders -->
    <Style x:Key="GSCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#CC2A1318" />
        <Setter Property="Stroke" Value="#664A2630" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="GSCardFilled" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#B31F0E12" />
        <Setter Property="Stroke" Value="#4D6B3742" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="GSStatusPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#403A2410" />
        <Setter Property="Stroke" Value="#66F59E0B" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="GSIconTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="BackgroundColor" Value="#403A2410" />
        <Setter Property="Stroke" Value="#55F59E0B" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>
    <Style x:Key="GSInput" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#B32A1318" />
        <Setter Property="Stroke" Value="#664A2630" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>

    <!-- Reusable glass layers -->
    <Style x:Key="GSGlassPanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#A61F0E12" />
        <Setter Property="Stroke" Value="#554A2630" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="GSGlassButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#B33A2410" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainer}" />
        <Setter Property="BorderColor" Value="#66F59E0B" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>