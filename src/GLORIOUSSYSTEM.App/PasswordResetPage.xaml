<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.PasswordResetPage"
             Title="Reset password"
             BackgroundColor="{DynamicResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="520"
                             HorizontalOptions="Center"
                             Padding="{OnIdiom Phone='20,28,20,32', Tablet='34,46,34,40', Desktop='40,58,40,44'}"
                             Spacing="0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,28">
                <Button Text="‹  Back" Style="{DynamicResource TertiaryButton}"
                        Clicked="OnCancelClicked" Padding="4,8" />
                <Label Grid.Column="1" Text="PASSWORD RESET" FontSize="10" FontAttributes="Bold"
                       CharacterSpacing="1.4" TextColor="{DynamicResource OnSurfaceVariant}"
                       VerticalOptions="Center" HorizontalTextAlignment="End" />
            </Grid>

            <Border Padding="22" Margin="0,0,0,22"
                    BackgroundColor="{DynamicResource SurfaceContainer}"
                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 24">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="58" HeightRequest="58"
                            BackgroundColor="{DynamicResource PrimaryContainer}"
                            Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18" Padding="7">
                        <Image Source="glorious_mark.png" Aspect="AspectFit" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Reset your password" FontSize="22" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurface}" />
                        <Label Text="We will send a one-time code to your Gmail address."
                               FontSize="12" LineHeight="1.35" TextColor="{DynamicResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="EMAIL" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4"
                   TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,7" />
            <Border HeightRequest="54" Padding="14,0" Margin="0,0,0,12"
                    BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                <Entry x:Name="EmailEntry" Placeholder="name@example.com" Keyboard="Email"
                       VerticalTextAlignment="Center" BackgroundColor="Transparent"
                       TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource OnSurfaceVariant}"
                       FontSize="14" ReturnType="Done" Completed="OnRequestCodeClicked" />
            </Border>

            <Button x:Name="RequestCodeButton" Text="Send reset code" Style="{DynamicResource PrimaryButton}"
                    HeightRequest="48" Clicked="OnRequestCodeClicked" />

            <Label x:Name="StatusLabel" IsVisible="False" FontSize="12" LineHeight="1.35"
                   TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,14,0,0" />

            <VerticalStackLayout x:Name="ResetFields" IsVisible="False" Spacing="0" Margin="0,22,0,0">
                <Label Text="RESET CODE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4"
                       TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,7" />
                <Border HeightRequest="54" Padding="14,0" Margin="0,0,0,16"
                        BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <Entry x:Name="CodeEntry" Placeholder="6-digit code" Keyboard="Numeric" MaxLength="6"
                           VerticalTextAlignment="Center" BackgroundColor="Transparent"
                           TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource OnSurfaceVariant}"
                           FontSize="14" />
                </Border>

                <Label Text="NEW PASSWORD" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4"
                       TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,7" />
                <Border HeightRequest="54" Padding="14,0" Margin="0,0,0,16"
                        BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <Entry x:Name="NewPasswordEntry" Placeholder="At least 8 characters" IsPassword="True"
                           VerticalTextAlignment="Center" BackgroundColor="Transparent"
                           TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource OnSurfaceVariant}"
                           FontSize="14" />
                </Border>

                <Label Text="CONFIRM PASSWORD" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4"
                       TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,7" />
                <Border HeightRequest="54" Padding="14,0" Margin="0,0,0,18"
                        BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <Entry x:Name="ConfirmPasswordEntry" Placeholder="Re-enter your password" IsPassword="True"
                           VerticalTextAlignment="Center" BackgroundColor="Transparent"
                           TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource OnSurfaceVariant}"
                           FontSize="14" ReturnType="Done" Completed="OnConfirmClicked" />
                </Border>

                <Button x:Name="ConfirmButton" Text="Reset password" Style="{DynamicResource PrimaryButton}"
                        HeightRequest="48" Clicked="OnConfirmClicked" />
            </VerticalStackLayout>

            <Label Text="Reset codes expire after 15 minutes and can only be used once."
                   FontSize="10" LineHeight="1.35" TextColor="{DynamicResource OnSurfaceVariant}"
                   HorizontalTextAlignment="Center" Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
