<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.WebcamPage"
             BackgroundColor="{StaticResource BgDark}">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
        <Label Text="Webcam feed will appear here" FontSize="18" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center"/>
        <Label Text="Connect once the cameras are wired to the Pi" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
</ContentPage>