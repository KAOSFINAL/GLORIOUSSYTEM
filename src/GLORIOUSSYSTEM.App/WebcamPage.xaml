<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.WebcamPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Leaf Classifier">
    <ScrollView>
        <VerticalStackLayout Padding="24,26,24,38" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="AI MONITORING" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource Primary}" />
                    <Label Text="Leaf Classifier" Style="{DynamicResource GSPageTitle}" />
                    <Label Text="Analyze lettuce health and growth with your trained CNN" Style="{DynamicResource GSPageSubtitle}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Style="{DynamicResource GSIconTile}" VerticalOptions="Start"><Label Text="AI" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
            </Grid>

            <Border Padding="18" BackgroundColor="{DynamicResource SurfaceBright}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2"><Label Text="Analyze a leaf" FontSize="19" FontAttributes="Bold" /><Label Text="Choose a photo or capture a new one" FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}" /></VerticalStackLayout>
                        <Border Grid.Column="1" Style="{DynamicResource GSStatusPill}"><Label Text="ON-DEVICE AI" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource Primary}" /></Border>
                    </Grid>

                    <Grid x:Name="PreviewContainer" HeightRequest="310">
                        <Border x:Name="PlaceholderBorder" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20" IsVisible="True">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border Style="{DynamicResource GSIconTile}" WidthRequest="66" HeightRequest="66"><Label Text="＋" FontSize="30" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <Label Text="No image selected" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="Choose a lettuce photo to begin analysis" FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="ImageBorder" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="8" IsVisible="False"><Image x:Name="PreviewImage" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                        <Border x:Name="LoadingBorder" BackgroundColor="#99000000" StrokeShape="RoundRectangle 18" Padding="20" IsVisible="False"><VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center"><ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="White" WidthRequest="40" HeightRequest="40" /><Label x:Name="LoadingLabel" Text="Analyzing..." FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" /></VerticalStackLayout></Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="9">
                        <Button x:Name="ChoosePhotoButton" Grid.Column="0" Text="Choose Photo" Style="{DynamicResource PrimaryButton}" Clicked="OnChoosePhotoClicked" HeightRequest="48" />
                        <Button x:Name="TakePhotoButton" Grid.Column="1" Text="Take Photo" Style="{DynamicResource SecondaryButton}" Clicked="OnTakePhotoClicked" HeightRequest="48" />
                        <Button x:Name="ClearButton" Grid.Column="2" Text="Clear" Style="{DynamicResource TertiaryButton}" Clicked="OnClearClicked" WidthRequest="68" HeightRequest="48" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ResultsCard" Padding="18" BackgroundColor="{DynamicResource SurfaceBright}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 22" IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Analysis results" FontSize="19" FontAttributes="Bold" /><Label Text="Classification and confidence" FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}" /></VerticalStackLayout><Border Grid.Column="1" Style="{DynamicResource GSStatusPill}"><Label Text="CNN" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource Primary}" /></Border></Grid>

                    <Border x:Name="LettuceDetectionCard" Padding="13" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"><Border x:Name="LettuceStatusBorder" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label x:Name="LettuceStatusIcon" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label x:Name="LettuceStatusLabel" FontSize="15" FontAttributes="Bold" /><Label x:Name="LettuceConfidenceLabel" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" /></VerticalStackLayout><Label Grid.Column="2" x:Name="LettuceDetailLabel" FontSize="10" HorizontalTextAlignment="End" VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}" /></Grid></Border>
                    <Border x:Name="HealthCard" Padding="13" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"><Border x:Name="HealthStatusBorder" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label x:Name="HealthStatusIcon" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label x:Name="HealthStatusLabel" FontSize="15" FontAttributes="Bold" /><Label x:Name="HealthConfidenceLabel" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" /></VerticalStackLayout><Label Grid.Column="2" x:Name="HealthDetailLabel" FontSize="10" HorizontalTextAlignment="End" VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}" /></Grid></Border>
                    <Border x:Name="AgeCard" Padding="13" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"><Border x:Name="AgeStatusBorder" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label x:Name="AgeStatusIcon" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label x:Name="AgeStatusLabel" FontSize="15" FontAttributes="Bold" /><Label x:Name="AgeConfidenceLabel" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" /></VerticalStackLayout><Label Grid.Column="2" x:Name="AgeDetailLabel" FontSize="10" HorizontalTextAlignment="End" VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}" /></Grid></Border>

                    <Label x:Name="DetailedPredictionsLabel" Text="Detailed predictions" FontSize="14" FontAttributes="Bold" Margin="0,5,0,0" IsVisible="False" />
                    <CollectionView x:Name="PredictionsList" ItemsLayout="VerticalList" HeightRequest="200" IsVisible="False"><CollectionView.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,7" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 11"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><BoxView Grid.Column="0" Color="{Binding Color}" WidthRequest="9" HeightRequest="9" CornerRadius="5" VerticalOptions="Center" /><Label Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding Confidence, StringFormat='{0:P0}'}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Color}" VerticalOptions="Center" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="9" Margin="0,4,0,0"><Button Grid.Column="0" Text="Save Result" Style="{DynamicResource SecondaryButton}" Clicked="OnSaveResultClicked" HeightRequest="46" /><Button Grid.Column="1" Text="Classify Another" Style="{DynamicResource TertiaryButton}" Clicked="OnClassifyAnotherClicked" HeightRequest="46" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="7"><Grid ColumnDefinitions="*,Auto"><Label Text="About the model" FontSize="15" FontAttributes="Bold" /><Label Grid.Column="1" Text="ONNX" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" /></Grid><Label Text="Multi-task MobileNetV2 for lettuce detection, health classification, and growth-stage estimation. Input: 224×224 RGB. Runs locally via ONNX Runtime." FontSize="11" LineHeight="1.3" TextColor="{DynamicResource OnSurfaceVariant}" /></VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>