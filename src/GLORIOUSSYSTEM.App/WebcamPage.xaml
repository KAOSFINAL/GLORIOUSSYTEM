<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.WebcamPage"
             BackgroundColor="{StaticResource BgDark}">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Leaf Classifier Test" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
        <Label Text="Pick a leaf photo to test the CNN model" FontSize="13" TextColor="{StaticResource TextSecondary}"/>

        <Button Text="Choose Photo" Clicked="OnChoosePhotoClicked"
                BackgroundColor="{StaticResource AccentGreen}" TextColor="#0F172A" FontAttributes="Bold"
                CornerRadius="8" Padding="0,12" WidthRequest="200" HorizontalOptions="Start"/>

        <Image x:Name="PreviewImage" HeightRequest="250" WidthRequest="250" HorizontalOptions="Start" Aspect="AspectFit"/>

        <Label x:Name="ResultLabel" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}"/>
        <Label x:Name="DetailLabel" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
    </VerticalStackLayout>
</ContentPage>