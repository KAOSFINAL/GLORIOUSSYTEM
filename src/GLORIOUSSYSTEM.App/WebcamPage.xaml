<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.WebcamPage"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#0F1115}"
             Title="Leaf Classifier">

    <ScrollView>
        <VerticalStackLayout Padding="24,22,24,34" Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Leaf Classifier" FontSize="30" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#151A21, Dark=#F5F7FA}" />
                    <Label Text="AI-powered lettuce health and growth analysis" FontSize="14"
                           TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                        Stroke="{AppThemeBinding Light=#E3E7ED, Dark=#2A3039}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 13" VerticalOptions="Start">
                    <Label Text="AI" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{DynamicResource Primary}" />
                </Border>
            </Grid>

            <!-- Capture Card -->
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                    Stroke="{AppThemeBinding Light=#E1E5EB, Dark=#292F38}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Analyze a leaf" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Use an existing image or capture a new one" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="8,5" BackgroundColor="{AppThemeBinding Light=#EEF8F4, Dark=#173229}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 9">
                            <Label Text="ON-DEVICE AI" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                        </Border>
                    </Grid>

                    <!-- Preview -->
                    <Grid x:Name="PreviewContainer" HeightRequest="300">
                        <Border x:Name="PlaceholderBorder"
                                BackgroundColor="{AppThemeBinding Light=#F7F9FA, Dark=#14171C}"
                                Stroke="{AppThemeBinding Light=#E2E6EB, Dark=#2A3039}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 16" Padding="20" IsVisible="True">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{AppThemeBinding Light=#EEF8F4, Dark=#173229}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                                    <Label Text="＋" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{DynamicResource Primary}" />
                                </Border>
                                <Label Text="No image selected" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="Choose a photo to begin analysis" FontSize="12" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="ImageBorder"
                                BackgroundColor="{AppThemeBinding Light=#F7F9FA, Dark=#14171C}"
                                StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E6EB, Dark=#2A3039}"
                                StrokeShape="RoundRectangle 16" Padding="8" IsVisible="False">
                            <Image x:Name="PreviewImage" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border x:Name="LoadingBorder" BackgroundColor="#99000000"
                                StrokeShape="RoundRectangle 16" Padding="20" IsVisible="False">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="White" WidthRequest="40" HeightRequest="40" />
                                <Label x:Name="LoadingLabel" Text="Analyzing..." FontSize="15" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="9">
                        <Button x:Name="ChoosePhotoButton" Grid.Column="0" Text="Choose Photo"
                                Style="{DynamicResource PrimaryButton}" Clicked="OnChoosePhotoClicked" HeightRequest="46" />
                        <Button x:Name="TakePhotoButton" Grid.Column="1" Text="Take Photo"
                                Style="{DynamicResource SecondaryButton}" Clicked="OnTakePhotoClicked" HeightRequest="46" />
                        <Button x:Name="ClearButton" Grid.Column="2" Text="Clear"
                                Style="{DynamicResource TertiaryButton}" Clicked="OnClearClicked"
                                WidthRequest="70" HeightRequest="46" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Results -->
            <Border x:Name="ResultsCard" Padding="16" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                    Stroke="{AppThemeBinding Light=#E1E5EB, Dark=#292F38}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20" IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Analysis results" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Model confidence and classification details" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="8,5" BackgroundColor="{AppThemeBinding Light=#F3F5F8, Dark=#232831}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 9">
                            <Label Text="CNN" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                        </Border>
                    </Grid>

                    <Border x:Name="LettuceDetectionCard" Padding="13" BackgroundColor="{AppThemeBinding Light=#F7F9FA, Dark=#15191E}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                            <Border x:Name="LettuceStatusBorder" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label x:Name="LettuceStatusIcon" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="LettuceStatusLabel" FontSize="15" FontAttributes="Bold" />
                                <Label x:Name="LettuceConfidenceLabel" FontSize="11" TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" x:Name="LettuceDetailLabel" FontSize="10" HorizontalTextAlignment="End" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                        </Grid>
                    </Border>

                    <Border x:Name="HealthCard" Padding="13" BackgroundColor="{AppThemeBinding Light=#F7F9FA, Dark=#15191E}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                            <Border x:Name="HealthStatusBorder" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label x:Name="HealthStatusIcon" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="HealthStatusLabel" FontSize="15" FontAttributes="Bold" />
                                <Label x:Name="HealthConfidenceLabel" FontSize="11" TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" x:Name="HealthDetailLabel" FontSize="10" HorizontalTextAlignment="End" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                        </Grid>
                    </Border>

                    <Border x:Name="AgeCard" Padding="13" BackgroundColor="{AppThemeBinding Light=#F7F9FA, Dark=#15191E}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                            <Border x:Name="AgeStatusBorder" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label x:Name="AgeStatusIcon" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="AgeStatusLabel" FontSize="15" FontAttributes="Bold" />
                                <Label x:Name="AgeConfidenceLabel" FontSize="11" TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" x:Name="AgeDetailLabel" FontSize="10" HorizontalTextAlignment="End" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                        </Grid>
                    </Border>

                    <Label x:Name="DetailedPredictionsLabel" Text="Detailed predictions" FontSize="14" FontAttributes="Bold" Margin="0,6,0,0" IsVisible="False" />
                    <CollectionView x:Name="PredictionsList" ItemsLayout="VerticalList" HeightRequest="200" IsVisible="False">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,7" BackgroundColor="{AppThemeBinding Light=#F7F9FA, Dark=#15191E}" StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <BoxView Grid.Column="0" Color="{Binding Color}" WidthRequest="9" HeightRequest="9" CornerRadius="5" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Confidence, StringFormat='{0:P0}'}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Color}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="9" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="Save Result" Style="{DynamicResource SecondaryButton}" Clicked="OnSaveResultClicked" HeightRequest="44" />
                        <Button Grid.Column="1" Text="Classify Another" Style="{DynamicResource TertiaryButton}" Clicked="OnClassifyAnotherClicked" HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Model Info -->
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                    Stroke="{AppThemeBinding Light=#E1E5EB, Dark=#292F38}" StrokeThickness="1" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="About the model" FontSize="15" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="ONNX" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                    </Grid>
                    <Label Text="Multi-task MobileNetV2 for lettuce detection, health classification, and growth-stage estimation. Input: 224×224 RGB. Runs locally via ONNX Runtime."
                           FontSize="11" LineHeight="1.3" TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>