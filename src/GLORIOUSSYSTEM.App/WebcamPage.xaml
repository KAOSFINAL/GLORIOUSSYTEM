<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.WebcamPage" BackgroundColor="{DynamicResource Surface}" Title="AI Crop Scanner" Shell.NavBarIsVisible="False">
<Grid ColumnDefinitions="260,*">
    <local:AppSidebar Grid.Column="0" CurrentRoute="webcam" />
    <ScrollView Grid.Column="1">
        <VerticalStackLayout Padding="30,28,36,42" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="WEBCAM" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource Primary}"/>
                    <Label Text="AI crop scanner" FontSize="32" FontAttributes="Bold"/>
                    <Label Text="Inspect lettuce health and growth stage with the trained CNN." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                    <Label Text="CNN" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource Primary}"/>
                    <Label Text="ONLINE" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" HorizontalTextAlignment="End" TextColor="{DynamicResource StatusOnline}"/>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="2.2*,*" ColumnSpacing="18">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="LIVE PREVIEW" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}"/>
                        <Label Grid.Column="1" Text="● READY" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource StatusOnline}"/>
                    </Grid>
                    <Border BackgroundColor="{DynamicResource OnSurface}" StrokeThickness="0" Padding="6">
                        <Grid x:Name="PreviewContainer" HeightRequest="420">
                            <Border x:Name="PlaceholderBorder" BackgroundColor="#26322B" StrokeThickness="0">
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="＋" FontSize="42" TextColor="{DynamicResource Brand300}" HorizontalTextAlignment="Center"/>
                                    <Label Text="READY TO SCAN" FontSize="17" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="Choose a photo or capture one" FontSize="11" TextColor="#AEB9B1" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="ImageBorder" BackgroundColor="#101510" StrokeThickness="0" Padding="2" IsVisible="False">
                                <Image x:Name="PreviewImage" Aspect="AspectFit"/>
                            </Border>
                            <Border x:Name="LoadingBorder" BackgroundColor="#CC101510" StrokeThickness="0" IsVisible="False">
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="White" WidthRequest="42" HeightRequest="42"/>
                                    <Label x:Name="LoadingLabel" Text="Analyzing crop…" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="ChoosePhotoButton" Text="CHOOSE PHOTO" Style="{DynamicResource PrimaryButton}" Clicked="OnChoosePhotoClicked" HeightRequest="48" CornerRadius="0"/>
                        <Button x:Name="TakePhotoButton" Grid.Column="1" Text="CAMERA" Style="{DynamicResource SecondaryButton}" Clicked="OnTakePhotoClicked" HeightRequest="48" CornerRadius="0"/>
                    </Grid>
                    <Button x:Name="ClearButton" Text="CLEAR SCAN" Style="{DynamicResource TertiaryButton}" Clicked="OnClearClicked" IsVisible="False" HeightRequest="38" CornerRadius="0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="10">
                    <Label Text="ASSESSMENT" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Border x:Name="ResultsCard" BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="1" Stroke="{DynamicResource OutlineVariant}" Padding="16" IsVisible="False">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1"><Label Text="Crop result" FontSize="19" FontAttributes="Bold"/><Label Text="Multi-task CNN" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                                <Label Grid.Column="1" Text="ONNX" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/>
                            <Border x:Name="LettuceDetectionCard" BackgroundColor="{DynamicResource Brand50}" StrokeThickness="0" Padding="12" IsVisible="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border x:Name="LettuceStatusBorder" WidthRequest="40" HeightRequest="40" StrokeThickness="0"><Label x:Name="LettuceStatusIcon" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1"><Label x:Name="LettuceStatusLabel" FontSize="14" FontAttributes="Bold"/><Label x:Name="LettuceConfidenceLabel" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                                    <Label Grid.Column="2" x:Name="LettuceDetailLabel" FontSize="9" VerticalOptions="Center" HorizontalTextAlignment="End"/>
                                </Grid>
                            </Border>
                            <Border x:Name="HealthCard" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="12" IsVisible="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Border x:Name="HealthStatusBorder" WidthRequest="40" HeightRequest="40" StrokeThickness="0"><Label x:Name="HealthStatusIcon" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="1"><Label x:Name="HealthStatusLabel" FontSize="14" FontAttributes="Bold"/><Label x:Name="HealthConfidenceLabel" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Label Grid.Column="2" x:Name="HealthDetailLabel" FontSize="9" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
                            </Border>
                            <Border x:Name="AgeCard" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="12" IsVisible="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Border x:Name="AgeStatusBorder" WidthRequest="40" HeightRequest="40" StrokeThickness="0"><Label x:Name="AgeStatusIcon" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="1"><Label x:Name="AgeStatusLabel" FontSize="14" FontAttributes="Bold"/><Label x:Name="AgeConfidenceLabel" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Label Grid.Column="2" x:Name="AgeDetailLabel" FontSize="9" VerticalOptions="Center" HorizontalTextAlignment="End"/></Grid>
                            </Border>
                            <Label x:Name="DetailedPredictionsLabel" Text="PREDICTION CONFIDENCE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2" IsVisible="False" Margin="0,4,0,0"/>
                            <CollectionView x:Name="PredictionsList" HeightRequest="180" IsVisible="False"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Padding="0,5"><Label Text="{Binding Label}" FontSize="11"/><Label Grid.Column="1" Text="{Binding Confidence, StringFormat='{0:P0}'}" FontSize="11" FontAttributes="Bold" TextColor="{Binding Color}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="SAVE RESULT" Style="{DynamicResource SecondaryButton}" Clicked="OnSaveResultClicked" HeightRequest="42" CornerRadius="0"/><Button Text="NEW SCAN" Grid.Column="1" Style="{DynamicResource TertiaryButton}" Clicked="OnClassifyAnotherClicked" HeightRequest="42" CornerRadius="0"/></Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="14">
                        <VerticalStackLayout Spacing="5"><Label Text="HOW THE AI WORKS" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.3" TextColor="{DynamicResource Primary}"/><Label Text="MobileNetV2 • 224×224 RGB • multi-task CNN" FontSize="13" FontAttributes="Bold"/><Label Text="The model detects lettuce, classifies health condition, and estimates growth stage locally with ONNX Runtime." FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" LineHeight="1.3"/></VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</Grid>
</ContentPage>
