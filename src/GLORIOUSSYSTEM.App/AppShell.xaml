<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
       x:Class="GLORIOUSSYSTEM.App.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Title="GLORIOUSSYSTEM">

    <FlyoutItem Title="Overview" Route="dashboard" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Title="Overview" />
    </FlyoutItem>
    <FlyoutItem Title="AI Crop Scanner" Route="webcam" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:WebcamPage}" Title="AI Crop Scanner" />
    </FlyoutItem>
    <FlyoutItem Title="Analytics" Route="reports" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:ReportsPage}" Title="Analytics" />
    </FlyoutItem>
    <FlyoutItem Title="Settings" Route="settings" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Title="Settings" />
    </FlyoutItem>
</Shell>
