<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
       x:Class="GLORIOUSSYSTEM.App.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Title="GLORIOUSSYSTEM">

    <FlyoutItem x:Name="DashboardItem" Title="Dashboard" Route="dashboard" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent x:Name="DashboardContent" Title="Dashboard" />
    </FlyoutItem>
    <FlyoutItem x:Name="WebcamItem" Title="Webcam" Route="webcam" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent x:Name="WebcamContent" Title="Webcam" />
    </FlyoutItem>
    <FlyoutItem x:Name="ReportsItem" Title="Reports" Route="reports" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent x:Name="ReportsContent" Title="Reports" />
    </FlyoutItem>
    <FlyoutItem x:Name="SettingsItem" Title="Settings" Route="settings" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent x:Name="SettingsContent" Title="Settings" />
    </FlyoutItem>
</Shell>
