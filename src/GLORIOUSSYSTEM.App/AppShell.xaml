<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
       x:Class="GLORIOUSSYSTEM.App.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{AppThemeBinding Light={DynamicResource Surface}, Dark={DynamicResource SurfaceDark}}"
       FlyoutWidth="280"
       Title="GLORIOUS SYSTEM">

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid RowDefinitions="Auto,Auto,Auto" Padding="20,30,20,20" RowSpacing="16">
            <!-- Brand -->
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="GLORIOUS SYSTEM"
                       FontSize="12"
                       TextColor="{DynamicResource Primary}"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       TextTransform="Uppercase"/>
                <Label Text="Lettuce Monitoring"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"/>
            </VerticalStackLayout>

            <!-- System Status Summary -->
            <Border Grid.Row="1"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}"
                    StrokeThickness="1"
                    Padding="12">
                <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                        <Label x:Name="FlyoutTotalSensors" Text="--" Style="{StaticResource TitleSmall}" HorizontalOptions="Center" TextColor="{DynamicResource Primary}"/>
                        <Label Text="Sensors" Style="{StaticResource LabelSmall}" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1" WidthRequest="1" Color="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}" VerticalOptions="Fill" Margin="0,4"/>
                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                        <Label x:Name="FlyoutOnlineSensors" Text="--" Style="{StaticResource TitleSmall}" HorizontalOptions="Center" TextColor="{DynamicResource StatusOnline}"/>
                        <Label Text="Online" Style="{StaticResource LabelSmall}" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    </VerticalStackLayout>
                    <BoxView Grid.Column="3" WidthRequest="1" Color="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}" VerticalOptions="Fill" Margin="0,4"/>
                    <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                        <Label x:Name="FlyoutAlerts" Text="--" Style="{StaticResource TitleSmall}" HorizontalOptions="Center" TextColor="{DynamicResource StatusCritical}"/>
                        <Label Text="Alerts" Style="{StaticResource LabelSmall}" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Version Info -->
            <Label Grid.Row="2" x:Name="FlyoutVersion" Text="v1.0.0" Style="{StaticResource LabelSmall}" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Navigation Items -->
    <FlyoutItem Title="Dashboard" Route="dashboard" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Title="Dashboard" Icon="📊" />
    </FlyoutItem>

    <FlyoutItem Title="Leaf Classifier" Route="webcam" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:WebcamPage}" Title="Leaf Classifier" Icon="🌿" />
    </FlyoutItem>

    <FlyoutItem Title="Reports" Route="reports" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:ReportsPage}" Title="Reports" Icon="📈" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="settings" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Title="Settings" Icon="⚙️" />
    </FlyoutItem>

    <!-- Flyout Footer -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,10,20,20" Spacing="12">
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}"/>

            <Button Text="Sign Out"
                    Style="{DynamicResource TertiaryButton}"
                    Clicked="OnLogoutClicked"
                    HorizontalOptions="Fill"
                    TextColor="{DynamicResource Error}"
                    BorderColor="{DynamicResource Error}"
                    BorderWidth="1">
                <Button.ImageSource>
                    <FontImageSource Glyph="🚪" Size="18"/>
                </Button.ImageSource>
            </Button>

            <Label x:Name="FlyoutLastSync" Text="Last sync: --" Style="{StaticResource LabelSmall}" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>