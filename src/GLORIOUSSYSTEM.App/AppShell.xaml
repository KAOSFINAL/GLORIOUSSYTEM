<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
       x:Class="GLORIOUSSYSTEM.App.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{DynamicResource SurfaceBright}"
       FlyoutWidth="292"
       Title="GLORIOUSSYTEM">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="24,30,24,22" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                <Border WidthRequest="52" HeightRequest="52" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 17">
                    <Label Text="G" FontSize="27" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="GLORIOUSSYTEM" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Label Text="Living Farm • Hydroponics" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Grid>
            <Border BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="9" HeightRequest="9" BackgroundColor="{DynamicResource StatusOnline}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="Farm system online" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnPrimaryContainer}" />
                        <Label Text="Sensors are reporting live data" FontSize="10" TextColor="{DynamicResource OnPrimaryContainer}" Opacity="0.72" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="LIVE" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Overview" Route="dashboard" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Title="Overview" />
    </FlyoutItem>
    <FlyoutItem Title="AI Crop Scanner" Route="webcam" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:WebcamPage}" Title="AI Crop Scanner" />
    </FlyoutItem>
    <FlyoutItem Title="Analytics" Route="reports" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:ReportsPage}" Title="Analytics" />
    </FlyoutItem>
    <FlyoutItem Title="Settings" Route="settings" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Title="Settings" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="24,14,24,24" Spacing="10">
            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <Label Text="☀" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{DynamicResource Tertiary}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="Solar-powered monitoring" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Label x:Name="FlyoutLastSync" Text="Last sync: --" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Grid>
            <Button Text="Sign Out" Style="{DynamicResource TertiaryButton}" Clicked="OnLogoutClicked" TextColor="{DynamicResource Error}" BorderColor="{DynamicResource Error}" BorderWidth="1" CornerRadius="14" HeightRequest="42" />
            <Label x:Name="FlyoutVersion" Text="GLORIOUSSYTEM  •  v1.0.0" FontSize="9" HorizontalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>