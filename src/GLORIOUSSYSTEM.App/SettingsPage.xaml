<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.SettingsPage" BackgroundColor="{DynamicResource Surface}" Title="Settings" Shell.NavBarIsVisible="False">
<Grid ColumnDefinitions="260,*" BackgroundColor="{DynamicResource Surface}">
    <local:AppSidebar Grid.Column="0" CurrentRoute="settings" />
    <ScrollView Grid.Column="1">
        <VerticalStackLayout Padding="42,34,48,40" Spacing="0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                <VerticalStackLayout Spacing="2"><Label Text="SETTINGS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="System configuration" FontSize="34" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Tune sensors and personalize the workspace." FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 21" VerticalOptions="Center"><Label Text="⚙" FontSize="20" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
            </Grid>
            <Label Text="SENSOR CONFIGURATION" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,8"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="1" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,0,0,14">
                <Border BackgroundColor="{DynamicResource SurfaceContainer}" Padding="15" StrokeThickness="0"><VerticalStackLayout Spacing="2"><Label Text="WATER" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label Text="pH • EC • Level • Flow" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
                <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="15" StrokeThickness="0"><VerticalStackLayout Spacing="2"><Label Text="ENVIRONMENT" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><Label Text="Temperature • Humidity" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
            </Grid>
            <CollectionView x:Name="SettingsList" ItemsLayout="VerticalList" EmptyView="No sensors configured" SelectionMode="None" Margin="0,0,0,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,8">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="11">
                                <BoxView WidthRequest="3" HeightRequest="42" BackgroundColor="{Binding CategoryColor}" Grid.RowSpan="2" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="{Binding Category}" FontSize="8" FontAttributes="Bold" TextColor="{Binding CategoryColor}" VerticalOptions="Center"/></HorizontalStackLayout><Label Text="{Binding Model}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="1"><Label Text="MONITOR" FontSize="7" FontAttributes="Bold" CharacterSpacing=".8" HorizontalTextAlignment="Center" TextColor="{DynamicResource OnSurfaceVariant}"/><Switch IsToggled="{Binding Enabled, Mode=TwoWay}" OnColor="{DynamicResource Primary}" ThumbColor="{DynamicResource OnSurface}"/></VerticalStackLayout>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2"><Label Text="MINIMUM" FontSize="7" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="7,0" HeightRequest="38"><Entry Text="{Binding MinThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent"/></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="MAXIMUM" FontSize="7" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="7,0" HeightRequest="38"><Entry Text="{Binding MaxThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent"/></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="STATUS" FontSize="7" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{Binding ThresholdStatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,10" HeightRequest="38" MinimumWidthRequest="92"><Label Text="{Binding ThresholdStatusText}" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border></VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="APPEARANCE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,6,0,8"/>
            <Border BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="13">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"><Border x:Name="PrimaryColorPreview" WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12"/><VerticalStackLayout Grid.Column="1" Spacing="1"><Label Text="Primary color" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Main system and navigation accent" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Picker x:Name="PrimaryColorPicker" Title="Choose primary color" SelectedIndexChanged="OnPrimaryColorChanged" HeightRequest="38"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Hydroponic Green (Default)</x:String><x:String>Ocean Blue</x:String><x:String>Sunset Orange</x:String><x:String>Deep Purple</x:String><x:String>Rose Pink</x:String><x:String>Teal</x:String><x:String>Indigo</x:String><x:String>Emerald</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="RESET" Style="{DynamicResource TertiaryButton}" WidthRequest="64" HeightRequest="36" Clicked="OnResetPrimaryColor"/></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"><Border x:Name="AccentColorPreview" WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource Secondary}" StrokeThickness="0" StrokeShape="RoundRectangle 12"/><VerticalStackLayout Grid.Column="1" Spacing="1"><Label Text="Accent color" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Secondary and water accents" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Picker x:Name="AccentColorPicker" Title="Choose accent color" SelectedIndexChanged="OnAccentColorChanged" HeightRequest="38"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Water Blue (Default)</x:String><x:String>Growth Green</x:String><x:String>Sun Amber</x:String><x:String>Alert Red</x:String><x:String>Purple</x:String><x:String>Cyan</x:String><x:String>Lime</x:String><x:String>Pink</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="RESET" Style="{DynamicResource TertiaryButton}" WidthRequest="64" HeightRequest="36" Clicked="OnResetAccentColor"/></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource SurfaceContainerHigh}" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label Text="◐" FontSize="19" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="Dark mode" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Use a darker workspace" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Switch x:Name="DarkModeSwitch" Grid.Column="2" IsToggled="{Binding DarkModeEnabled, Mode=TwoWay}" Toggled="OnDarkModeToggled" OnColor="{DynamicResource Primary}" ThumbColor="{DynamicResource OnSurface}"/></Grid>
                </VerticalStackLayout>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button x:Name="SaveButton" Text="SAVE CHANGES" Style="{DynamicResource PrimaryButton}" Clicked="OnSaveClicked" HeightRequest="46"/><Button x:Name="ResetButton" Grid.Column="1" Text="RESET ALL" Style="{DynamicResource TertiaryButton}" Clicked="OnResetAllClicked" HeightRequest="46" WidthRequest="100"/></Grid>
        </VerticalStackLayout>
    </ScrollView>
</Grid>
</ContentPage>