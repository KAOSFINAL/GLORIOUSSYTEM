<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.SettingsPage" BackgroundColor="{DynamicResource Surface}" Title="Settings" Shell.NavBarIsVisible="False">
<Grid ColumnDefinitions="260,*">
    <local:AppSidebar Grid.Column="0" CurrentRoute="settings" />
    <ScrollView Grid.Column="1">
        <VerticalStackLayout Padding="30,28,36,42" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3"><Label Text="SETTINGS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource Primary}"/><Label Text="System configuration" FontSize="32" FontAttributes="Bold"/><Label Text="Tune sensors and personalize the workspace." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                <Label Grid.Column="1" Text="⚙" FontSize="27" TextColor="{DynamicResource Primary}" VerticalOptions="Center"/>
            </Grid>

            <Label Text="SENSOR CONFIGURATION" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource Primary}" Margin="0,5,0,0"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="1" BackgroundColor="{DynamicResource OutlineVariant}">
                <Border BackgroundColor="{DynamicResource SecondaryContainer}" Padding="15" StrokeThickness="0"><VerticalStackLayout Spacing="2"><Label Text="WATER" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label Text="pH • EC • Level • Flow" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
                <Border Grid.Column="1" BackgroundColor="{DynamicResource PrimaryContainer}" Padding="15" StrokeThickness="0"><VerticalStackLayout Spacing="2"><Label Text="ENVIRONMENT" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><Label Text="Temperature • Humidity" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
            </Grid>

            <CollectionView x:Name="SettingsList" ItemsLayout="VerticalList" EmptyView="No sensors configured" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="1" Stroke="{DynamicResource OutlineVariant}" Padding="15" Margin="0,0,0,6">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13" RowSpacing="12">
                                <BoxView WidthRequest="5" HeightRequest="44" BackgroundColor="{Binding CategoryColor}" Grid.RowSpan="2" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="1"><HorizontalStackLayout Spacing="8"><Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"/><Label Text="{Binding Category}" FontSize="8" FontAttributes="Bold" TextColor="{Binding CategoryColor}" VerticalOptions="Center"/></HorizontalStackLayout><Label Text="{Binding Model}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="MONITOR" FontSize="7" FontAttributes="Bold" CharacterSpacing=".8" HorizontalTextAlignment="Center" TextColor="{DynamicResource OnSurfaceVariant}"/><Switch IsToggled="{Binding Enabled, Mode=TwoWay}" OnColor="{DynamicResource Primary}" ThumbColor="White"/></VerticalStackLayout>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2"><Label Text="MINIMUM" FontSize="7" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="8,0" HeightRequest="40"><Entry Text="{Binding MinThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent"/></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="MAXIMUM" FontSize="7" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="8,0" HeightRequest="40"><Entry Text="{Binding MaxThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent"/></Border></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="STATUS" FontSize="7" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{Binding ThresholdStatusColor}" StrokeThickness="0" Padding="11,11" HeightRequest="40" MinimumWidthRequest="92"><Label Text="{Binding ThresholdStatusText}" FontSize="8" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border></VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="APPEARANCE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource Primary}" Margin="0,8,0,0"/>
            <Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="1" Stroke="{DynamicResource OutlineVariant}" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="PrimaryColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0"/><VerticalStackLayout Grid.Column="1" Spacing="1"><Label Text="Primary color" FontSize="14" FontAttributes="Bold"/><Label Text="Main system and navigation accent" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Picker x:Name="PrimaryColorPicker" Title="Choose primary color" SelectedIndexChanged="OnPrimaryColorChanged" HeightRequest="38"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Hydroponic Green (Default)</x:String><x:String>Ocean Blue</x:String><x:String>Sunset Orange</x:String><x:String>Deep Purple</x:String><x:String>Rose Pink</x:String><x:String>Teal</x:String><x:String>Indigo</x:String><x:String>Emerald</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="RESET" Style="{DynamicResource TertiaryButton}" WidthRequest="64" HeightRequest="38" Clicked="OnResetPrimaryColor" CornerRadius="0"/></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="AccentColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Secondary}" StrokeThickness="0"/><VerticalStackLayout Grid.Column="1" Spacing="1"><Label Text="Accent color" FontSize="14" FontAttributes="Bold"/><Label Text="Secondary and water accents" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Picker x:Name="AccentColorPicker" Title="Choose accent color" SelectedIndexChanged="OnAccentColorChanged" HeightRequest="38"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Water Blue (Default)</x:String><x:String>Growth Green</x:String><x:String>Sun Amber</x:String><x:String>Alert Red</x:String><x:String>Purple</x:String><x:String>Cyan</x:String><x:String>Lime</x:String><x:String>Pink</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="RESET" Style="{DynamicResource TertiaryButton}" WidthRequest="64" HeightRequest="38" Clicked="OnResetAccentColor" CornerRadius="0"/></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0"><Label Text="◐" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="Dark mode" FontSize="14" FontAttributes="Bold"/><Label Text="Use a darker workspace" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Switch x:Name="DarkModeSwitch" Grid.Column="2" IsToggled="{Binding DarkModeEnabled, Mode=TwoWay}" Toggled="OnDarkModeToggled" OnColor="{DynamicResource Primary}" ThumbColor="White"/></Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button x:Name="SaveButton" Text="SAVE CHANGES" Style="{DynamicResource PrimaryButton}" Clicked="OnSaveClicked" HeightRequest="48" CornerRadius="0"/><Button x:Name="ResetButton" Grid.Column="1" Text="RESET ALL" Style="{DynamicResource TertiaryButton}" Clicked="OnResetAllClicked" HeightRequest="48" WidthRequest="100" CornerRadius="0"/></Grid>
        </VerticalStackLayout>
    </ScrollView>
</Grid>
</ContentPage>
