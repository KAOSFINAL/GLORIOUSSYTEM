<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.SettingsPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Settings">
    <ContentPage.Resources><local:NotZeroConverter x:Key="NotZeroConverter" /></ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="24,26,24,38" Spacing="20">
            <VerticalStackLayout Spacing="4"><Label Text="SYSTEM" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource Primary}" /><Label Text="Settings" Style="{DynamicResource GSPageTitle}" /><Label Text="Configure sensors, appearance, and system preferences" Style="{DynamicResource GSPageSubtitle}" /></VerticalStackLayout>

            <Border Style="{DynamicResource GSCard}">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Sensor settings" Style="{DynamicResource GSSectionTitle}" /><Label Text="Thresholds and monitoring status" Style="{DynamicResource GSMuted}" /></VerticalStackLayout><Border Grid.Column="1" Style="{DynamicResource GSStatusPill}"><Label Text="LIVE" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" /></Border></Grid>
                    <CollectionView x:Name="SettingsList" ItemsLayout="VerticalList" EmptyView="No sensors configured" HeightRequest="400">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="4"><Label Text="{Binding Name}" Style="{DynamicResource TitleMedium}" /><HorizontalStackLayout Spacing="7"><Border BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="7,3"><Label Text="{Binding Type}" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnPrimaryContainer}" /></Border><Label Text="{Binding Model}" Style="{DynamicResource GSMuted}" VerticalOptions="Center" /></HorizontalStackLayout></VerticalStackLayout>
                                            <Switch Grid.Column="1" IsToggled="{Binding Enabled, Mode=TwoWay}" OnColor="{DynamicResource Primary}" ThumbColor="{DynamicResource OnPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasThresholds}">
                                            <VerticalStackLayout Spacing="5"><Label Text="MINIMUM" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{DynamicResource OnSurfaceVariant}" /><Border Style="{DynamicResource GSInput}"><Entry Text="{Binding MinThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" Placeholder="Min" BackgroundColor="Transparent" VerticalOptions="Center" /></Border></VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="MAXIMUM" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{DynamicResource OnSurfaceVariant}" /><Border Style="{DynamicResource GSInput}"><Entry Text="{Binding MaxThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" Placeholder="Max" BackgroundColor="Transparent" VerticalOptions="Center" /></Border></VerticalStackLayout>
                                        </Grid>
                                        <Border Padding="9,5" StrokeThickness="0" BackgroundColor="{Binding ThresholdStatusColor}" IsVisible="{Binding HasThresholds}" HorizontalOptions="Start" StrokeShape="RoundRectangle 8"><Label Text="{Binding ThresholdStatusText}" FontSize="9" FontAttributes="Bold" TextColor="{Binding ThresholdStatusTextColor}" /></Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{DynamicResource GSCard}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="2"><Label Text="Appearance" Style="{DynamicResource GSSectionTitle}" /><Label Text="Customize the visual style of the app" Style="{DynamicResource GSMuted}" /></VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="PrimaryColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Primary}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12" /><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Primary color" Style="{DynamicResource TitleSmall}" /><Label Text="Main actions and highlights" Style="{DynamicResource GSMuted}" /><Picker x:Name="PrimaryColorPicker" Title="Select color" SelectedIndexChanged="OnPrimaryColorChanged" HeightRequest="40"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Hydroponic Green (Default)</x:String><x:String>Ocean Blue</x:String><x:String>Sunset Orange</x:String><x:String>Deep Purple</x:String><x:String>Rose Pink</x:String><x:String>Teal</x:String><x:String>Indigo</x:String><x:String>Emerald</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="66" Clicked="OnResetPrimaryColor" /></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="AccentColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Secondary}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12" /><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Accent color" Style="{DynamicResource TitleSmall}" /><Label Text="Secondary actions and accents" Style="{DynamicResource GSMuted}" /><Picker x:Name="AccentColorPicker" Title="Select color" SelectedIndexChanged="OnAccentColorChanged" HeightRequest="40"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Water Blue (Default)</x:String><x:String>Growth Green</x:String><x:String>Sun Amber</x:String><x:String>Alert Red</x:String><x:String>Purple</x:String><x:String>Cyan</x:String><x:String>Lime</x:String><x:String>Pink</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="66" Clicked="OnResetAccentColor" /></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="2"><Label Text="Dark mode" Style="{DynamicResource TitleSmall}" /><Label Text="Use a darker interface in low-light environments" Style="{DynamicResource GSMuted}" /></VerticalStackLayout><Switch x:Name="DarkModeSwitch" Grid.Column="1" IsToggled="{Binding DarkModeEnabled, Mode=TwoWay}" Toggled="OnDarkModeToggled" OnColor="{DynamicResource Primary}" ThumbColor="{DynamicResource OnPrimary}" /></Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="BackgroundColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12" /><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Background style" Style="{DynamicResource TitleSmall}" /><Label Text="Choose the app background" Style="{DynamicResource GSMuted}" /><Picker x:Name="BackgroundColorPicker" Title="Select background" SelectedIndexChanged="OnBackgroundColorChanged" HeightRequest="40"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Light Gray (Default)</x:String><x:String>Pure White</x:String><x:String>Warm White</x:String><x:String>Soft Green</x:String><x:String>Soft Blue</x:String><x:String>Dark Charcoal</x:String><x:String>Dark Navy</x:String><x:String>Custom Color</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="66" Clicked="OnResetBackgroundColor" IsVisible="{Binding Source={x:Reference BackgroundColorPicker}, Path=SelectedIndex, Converter={StaticResource NotZeroConverter}}" /></Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="9"><Button x:Name="SaveButton" Text="Save Changes" Style="{DynamicResource PrimaryButton}" Clicked="OnSaveClicked" IsEnabled="{Binding HasChanges}" HeightRequest="52" /><Button x:Name="ResetButton" Text="Reset to Defaults" Style="{DynamicResource TertiaryButton}" Clicked="OnResetAllClicked" HeightRequest="46" /></VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>