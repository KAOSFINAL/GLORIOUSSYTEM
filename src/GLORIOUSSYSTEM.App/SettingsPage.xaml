<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.SettingsPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Settings">

    <ContentPage.Resources>
        <local:NotZeroConverter x:Key="NotZeroConverter" />
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{DynamicResource Surface}">
        <VerticalStackLayout Padding="24,24,24,36" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Settings" Style="{DynamicResource GSPageTitle}" />
                <Label Text="Manage sensors, appearance, and system preferences"
                       Style="{DynamicResource GSPageSubtitle}" />
            </VerticalStackLayout>

            <!-- Sensor Settings -->
            <Border Style="{DynamicResource GSCard}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Sensor Settings" Style="{DynamicResource GSSectionTitle}" />
                            <Label Text="Configure thresholds and monitoring status"
                                   Style="{DynamicResource GSMuted}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                Style="{DynamicResource GSStatusPill}"
                                VerticalOptions="Start">
                            <Label Text="LIVE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" />
                        </Border>
                    </Grid>

                    <CollectionView x:Name="SettingsList"
                                    ItemsLayout="VerticalList"
                                    EmptyView="No sensors configured"
                                    HeightRequest="400">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                        Stroke="{DynamicResource OutlineVariant}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="5">
                                                <Label Text="{Binding Name}"
                                                       Style="{DynamicResource TitleMedium}" />
                                                <HorizontalStackLayout Spacing="7">
                                                    <Border BackgroundColor="{DynamicResource PrimaryContainer}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 7"
                                                            Padding="7,3">
                                                        <Label Text="{Binding Type}"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource OnPrimaryContainer}" />
                                                    </Border>
                                                    <Label Text="{Binding Model}"
                                                           Style="{DynamicResource GSMuted}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Switch Grid.Column="1"
                                                    IsToggled="{Binding Enabled, Mode=TwoWay}"
                                                    OnColor="{DynamicResource Primary}"
                                                    ThumbColor="{DynamicResource OnPrimary}"
                                                    VerticalOptions="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10"
                                              IsVisible="{Binding HasThresholds}">
                                            <VerticalStackLayout Spacing="5">
                                                <Label Text="MINIMUM"
                                                       Style="{DynamicResource LabelMedium}" />
                                                <Border BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                                        Stroke="{DynamicResource OutlineVariant}"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="10,0"
                                                        HeightRequest="42">
                                                    <Entry Text="{Binding MinThreshold, Mode=TwoWay, StringFormat='{0:F1}'}"
                                                           Keyboard="Numeric"
                                                           Placeholder="Min"
                                                           BackgroundColor="Transparent"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                                <Label Text="MAXIMUM"
                                                       Style="{DynamicResource LabelMedium}" />
                                                <Border BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                                        Stroke="{DynamicResource OutlineVariant}"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="10,0"
                                                        HeightRequest="42">
                                                    <Entry Text="{Binding MaxThreshold, Mode=TwoWay, StringFormat='{0:F1}'}"
                                                           Keyboard="Numeric"
                                                           Placeholder="Max"
                                                           BackgroundColor="Transparent"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border Padding="9,5"
                                                StrokeThickness="0"
                                                BackgroundColor="{Binding ThresholdStatusColor}"
                                                IsVisible="{Binding HasThresholds}"
                                                HorizontalOptions="Start"
                                                StrokeShape="RoundRectangle 8">
                                            <Label Text="{Binding ThresholdStatusText}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding ThresholdStatusTextColor}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Appearance -->
            <Border Style="{DynamicResource GSCard}">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Appearance" Style="{DynamicResource GSSectionTitle}" />
                        <Label Text="Customize colors and display preferences"
                               Style="{DynamicResource GSMuted}" />
                    </VerticalStackLayout>

                    <!-- Primary -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border x:Name="PrimaryColorPreview"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{DynamicResource Primary}"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Primary Color" Style="{DynamicResource TitleSmall}" />
                            <Label Text="Buttons, active states, and highlights" Style="{DynamicResource GSMuted}" />
                            <Picker x:Name="PrimaryColorPicker"
                                    Title="Select color"
                                    SelectedIndexChanged="OnPrimaryColorChanged"
                                    HeightRequest="38">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Hydroponic Green (Default)</x:String>
                                        <x:String>Ocean Blue</x:String>
                                        <x:String>Sunset Orange</x:String>
                                        <x:String>Deep Purple</x:String>
                                        <x:String>Rose Pink</x:String>
                                        <x:String>Teal</x:String>
                                        <x:String>Indigo</x:String>
                                        <x:String>Emerald</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="72" Clicked="OnResetPrimaryColor" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <!-- Accent -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border x:Name="AccentColorPreview"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{DynamicResource Secondary}"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Accent Color" Style="{DynamicResource TitleSmall}" />
                            <Label Text="Secondary actions and visual accents" Style="{DynamicResource GSMuted}" />
                            <Picker x:Name="AccentColorPicker"
                                    Title="Select color"
                                    SelectedIndexChanged="OnAccentColorChanged"
                                    HeightRequest="38">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Water Blue (Default)</x:String>
                                        <x:String>Growth Green</x:String>
                                        <x:String>Sun Amber</x:String>
                                        <x:String>Alert Red</x:String>
                                        <x:String>Purple</x:String>
                                        <x:String>Cyan</x:String>
                                        <x:String>Lime</x:String>
                                        <x:String>Pink</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="72" Clicked="OnResetAccentColor" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <!-- Dark mode -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="Dark Mode" Style="{DynamicResource TitleSmall}" />
                            <Label Text="Use a darker interface for low-light environments" Style="{DynamicResource GSMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="DarkModeSwitch"
                                Grid.Column="1"
                                IsToggled="{Binding DarkModeEnabled, Mode=TwoWay}"
                                Toggled="OnDarkModeToggled"
                                OnColor="{DynamicResource Primary}"
                                ThumbColor="{DynamicResource OnPrimary}"
                                VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <!-- Background -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border x:Name="BackgroundColorPreview"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Background Style" Style="{DynamicResource TitleSmall}" />
                            <Label Text="Choose the app background appearance" Style="{DynamicResource GSMuted}" />
                            <Picker x:Name="BackgroundColorPicker"
                                    Title="Select background"
                                    SelectedIndexChanged="OnBackgroundColorChanged"
                                    HeightRequest="38">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Light Gray (Default)</x:String>
                                        <x:String>Pure White</x:String>
                                        <x:String>Warm White</x:String>
                                        <x:String>Soft Green</x:String>
                                        <x:String>Soft Blue</x:String>
                                        <x:String>Dark Charcoal</x:String>
                                        <x:String>Dark Navy</x:String>
                                        <x:String>Custom Color</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="Reset"
                                Style="{DynamicResource TertiaryButton}"
                                WidthRequest="72"
                                Clicked="OnResetBackgroundColor"
                                VerticalOptions="Center"
                                IsVisible="{Binding Source={x:Reference BackgroundColorPicker}, Path=SelectedIndex, Converter={StaticResource NotZeroConverter}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="10">
                <Button x:Name="SaveButton"
                        Text="Save Changes"
                        Style="{DynamicResource PrimaryButton}"
                        Clicked="OnSaveClicked"
                        HorizontalOptions="Fill"
                        IsEnabled="{Binding HasChanges}"
                        HeightRequest="50" />
                <Button x:Name="ResetButton"
                        Text="Reset to Defaults"
                        Style="{DynamicResource TertiaryButton}"
                        Clicked="OnResetAllClicked"
                        HorizontalOptions="Fill"
                        HeightRequest="46" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
