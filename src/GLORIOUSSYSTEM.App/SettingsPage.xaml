<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.SettingsPage"
             x:DataType="local:SettingsPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Settings"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto" BackgroundColor="{DynamicResource Surface}">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="960" HorizontalOptions="Center"
                                 Padding="{OnIdiom Phone='18,24,18,28', Tablet='36,34,36,32', Desktop='48,38,48,36'}"
                                 Spacing="0">
                <VerticalStackLayout Spacing="2" Margin="0,0,0,22">
                    <Label Text="SYSTEM PREFERENCES" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="{DynamicResource Primary}" />
                    <Label Text="Settings" FontSize="{OnIdiom Phone=27, Tablet=31, Desktop=32}"
                           FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    <Label Text="Manage sensor thresholds and the dashboard appearance."
                           FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Sensor configuration" FontSize="19" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                        <Label Text="Monitoring state and alert ranges" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="10,7" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource TertiaryContainer}" Stroke="Transparent"
                            StrokeShape="RoundRectangle 15">
                        <Label Text="LIVE CONFIG" FontSize="8" FontAttributes="Bold" CharacterSpacing="1"
                               TextColor="{DynamicResource OnTertiaryContainer}" />
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="SettingsList" Spacing="0" Margin="0,0,0,22">
                    <BindableLayout.EmptyView>
                        <Label Text="No sensors are configured." FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,12" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:SensorSetting">
                            <Border Padding="15" Margin="0,0,0,10"
                                    BackgroundColor="{DynamicResource SurfaceContainer}"
                                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 19">
                                <VerticalStackLayout Spacing="13">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                        <Border WidthRequest="42" HeightRequest="42" Margin="0" Padding="0"
                                                BackgroundColor="{Binding CategoryContainerColor}"
                                                Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                            <Label Text="{Binding CategoryIcon}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding CategoryColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{DynamicResource OnSurface}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Model}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label Text="MONITOR" FontSize="7" FontAttributes="Bold"
                                                   TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                                            <Switch IsToggled="{Binding Enabled, Mode=TwoWay}" OnColor="{DynamicResource Primary}"
                                                    ThumbColor="{DynamicResource OnSurface}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="MINIMUM" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}" />
                                            <Border HeightRequest="44" Padding="10,0" Margin="0"
                                                    BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                                <Entry Text="{Binding MinThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric"
                                                       FontSize="13" TextColor="{DynamicResource OnSurface}" BackgroundColor="Transparent" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="MAXIMUM" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}" />
                                            <Border HeightRequest="44" Padding="10,0" Margin="0"
                                                    BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                                <Entry Text="{Binding MaxThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric"
                                                       FontSize="13" TextColor="{DynamicResource OnSurface}" BackgroundColor="Transparent" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Alert threshold status" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Padding="10,6" Margin="0"
                                                BackgroundColor="{Binding ThresholdStatusColor}" Stroke="Transparent"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                            <Label Text="{Binding ThresholdStatusText}" FontSize="8" FontAttributes="Bold"
                                                   TextColor="{Binding ThresholdStatusTextColor}" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Appearance" FontSize="19" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" Margin="0,0,0,10" />
                <Border Padding="16" Margin="0,0,0,18"
                        BackgroundColor="{DynamicResource SurfaceContainer}"
                        Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border x:Name="PrimaryColorPreview" WidthRequest="42" HeightRequest="42" Margin="0"
                                    BackgroundColor="{DynamicResource Primary}" Stroke="{DynamicResource OutlineVariant}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 13" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Action color" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                                <Picker x:Name="PrimaryColorPicker" Title="Choose action color" HeightRequest="40" FontSize="11"
                                        SelectedIndexChanged="OnPrimaryColorChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Emerald</x:String><x:String>Sky</x:String><x:String>Lime</x:String><x:String>Cyan</x:String>
                                            <x:String>Violet</x:String><x:String>Orange</x:String><x:String>Rose</x:String><x:String>Teal</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}"
                                    WidthRequest="66" HeightRequest="40" FontSize="10" Padding="8" Clicked="OnResetPrimaryColor" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border x:Name="AccentColorPreview" WidthRequest="42" HeightRequest="42" Margin="0"
                                    BackgroundColor="{DynamicResource Secondary}" Stroke="{DynamicResource OutlineVariant}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 13" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Solar accent" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                                <Picker x:Name="AccentColorPicker" Title="Choose accent color" HeightRequest="40" FontSize="11"
                                        SelectedIndexChanged="OnAccentColorChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Solar gold</x:String><x:String>Sky</x:String><x:String>Violet</x:String><x:String>Cyan</x:String>
                                            <x:String>Lime</x:String><x:String>Orange</x:String><x:String>Rose</x:String><x:String>Teal</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}"
                                    WidthRequest="66" HeightRequest="40" FontSize="10" Padding="8" Clicked="OnResetAccentColor" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="42" HeightRequest="42" Margin="0" Padding="0"
                                    BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                    Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 13">
                                <Label Text="Aa" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Dark mode" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                                <Label Text="Use the low-glare control-room palette" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch x:Name="DarkModeSwitch" Grid.Column="2"
                                    IsToggled="{Binding DarkModeEnabled, Mode=TwoWay}" Toggled="OnDarkModeToggled"
                                    OnColor="{DynamicResource Primary}" ThumbColor="{DynamicResource OnSurface}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                    <Button x:Name="SaveButton" Text="Save changes" Style="{DynamicResource PrimaryButton}"
                            Clicked="OnSaveClicked" HeightRequest="48" />
                    <Button x:Name="ResetButton" Grid.Column="1" Text="Reset all" Style="{DynamicResource TertiaryButton}"
                            Clicked="OnResetAllClicked" HeightRequest="48" WidthRequest="92" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <local:AppSidebar Grid.Row="1" CurrentRoute="settings" />
    </Grid>
</ContentPage>
