<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.SettingsPage" BackgroundColor="{DynamicResource Surface}" Title="Settings" Shell.NavBarIsVisible="False">
<ContentPage.Resources><local:NotZeroConverter x:Key="NotZeroConverter"/></ContentPage.Resources>
<Grid ColumnDefinitions="260,*">
<local:AppSidebar Grid.Column="0" CurrentRoute="settings" />
<ScrollView Grid.Column="1"><VerticalStackLayout Padding="28,30,28,42" Spacing="24">
<VerticalStackLayout Spacing="4"><Label Text="SYSTEM CONTROL" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource Primary}"/><Label Text="Tune your farm" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Configure the monitoring behavior of your hydroponic system." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
<Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 25" Padding="20"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF20" StrokeThickness="0" StrokeShape="RoundRectangle 15"><Label Text="⚙" FontSize="22" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="Farm control center" FontSize="17" FontAttributes="Bold" TextColor="White"/><Label Text="Sensor settings are applied to live monitoring" FontSize="10" TextColor="{DynamicResource Brand200}"/></VerticalStackLayout><Border Grid.Column="2" BackgroundColor="#FFFFFF20" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6" VerticalOptions="Center"><Label Text="● LIVE" FontSize="9" FontAttributes="Bold" TextColor="White"/></Border></Grid></Border>
<VerticalStackLayout Spacing="10">
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Sensor configuration" FontSize="21" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Set which sensors are monitored and where normal operating limits begin." FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,7" VerticalOptions="Center"><Label Text="MIN / MAX" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/></Border></Grid>
<CollectionView x:Name="SettingsList" ItemsLayout="VerticalList" EmptyView="No sensors configured" HeightRequest="470" SelectionMode="None">
<CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="17" Margin="0,0,0,12"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="13">
<Border WidthRequest="46" HeightRequest="46" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label Text="⌁" FontSize="21" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
<VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="{Binding Type}" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/><HorizontalStackLayout Spacing="5"><Label Text="●" FontSize="8" TextColor="{DynamicResource StatusOnline}"/><Label Text="Monitoring enabled" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></HorizontalStackLayout></VerticalStackLayout>
<Switch Grid.Column="2" IsToggled="{Binding Enabled, Mode=TwoWay}" OnColor="{DynamicResource Primary}" ThumbColor="White" VerticalOptions="Center"/>
<VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="8" IsVisible="{Binding HasThresholds}"><Grid ColumnDefinitions="*,Auto"><Label Text="SAFE OPERATING RANGE" FontSize="8" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="{Binding ThresholdStatusText}" Grid.Column="1" FontSize="9" FontAttributes="Bold" TextColor="{Binding ThresholdStatusTextColor}"/></Grid><Grid HeightRequest="8"><BoxView BackgroundColor="{DynamicResource SurfaceContainerHighest}" CornerRadius="4" HeightRequest="8" VerticalOptions="Center"/><BoxView BackgroundColor="{DynamicResource Primary}" CornerRadius="4" HeightRequest="8" HorizontalOptions="Fill" VerticalOptions="Center"/></Grid></VerticalStackLayout>
<Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,*,Auto" ColumnSpacing="10" IsVisible="{Binding HasThresholds}"><VerticalStackLayout Spacing="4"><Label Text="MINIMUM" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0"><Entry Text="{Binding MinThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" BackgroundColor="Transparent" HeightRequest="42"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="MAXIMUM" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0"><Entry Text="{Binding MaxThreshold, Mode=TwoWay, StringFormat='{0:F1}'}" Keyboard="Numeric" BackgroundColor="Transparent" HeightRequest="42"/></Border></VerticalStackLayout><Border Grid.Column="2" BackgroundColor="{Binding ThresholdStatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="10,8" VerticalOptions="End"><Label Text="{Binding ThresholdStatusText}" FontSize="9" FontAttributes="Bold" TextColor="{Binding ThresholdStatusTextColor}"/></Border></Grid>
</Grid></Border></DataTemplate></CollectionView.ItemTemplate>
</CollectionView></VerticalStackLayout>
<VerticalStackLayout Spacing="10"><Label Text="Appearance" FontSize="21" FontAttributes="Bold"/><Label Text="Adjust the visual theme for your workspace." FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/><Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 23" Padding="18"><VerticalStackLayout Spacing="14"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="PrimaryColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 13"/><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Primary color" FontSize="14" FontAttributes="Bold"/><Label Text="Actions and navigation accents" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/><Picker x:Name="PrimaryColorPicker" Title="Choose color" SelectedIndexChanged="OnPrimaryColorChanged" HeightRequest="40"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Hydroponic Green (Default)</x:String><x:String>Ocean Blue</x:String><x:String>Sunset Orange</x:String><x:String>Deep Purple</x:String><x:String>Rose Pink</x:String><x:String>Teal</x:String><x:String>Indigo</x:String><x:String>Emerald</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="66" Clicked="OnResetPrimaryColor"/></Grid><BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Dark mode" FontSize="14" FontAttributes="Bold"/><Label Text="Use a darker interface in low light" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Switch x:Name="DarkModeSwitch" Grid.Column="1" IsToggled="{Binding DarkModeEnabled, Mode=TwoWay}" Toggled="OnDarkModeToggled" OnColor="{DynamicResource Primary}" ThumbColor="White"/></Grid><BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}"/><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border x:Name="AccentColorPreview" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Secondary}" StrokeThickness="0" StrokeShape="RoundRectangle 13"/><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Accent color" FontSize="14" FontAttributes="Bold"/><Label Text="Water and secondary accents" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/><Picker x:Name="AccentColorPicker" Title="Choose accent" SelectedIndexChanged="OnAccentColorChanged" HeightRequest="40"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Water Blue (Default)</x:String><x:String>Growth Green</x:String><x:String>Sun Amber</x:String><x:String>Alert Red</x:String><x:String>Purple</x:String><x:String>Cyan</x:String><x:String>Lime</x:String><x:String>Pink</x:String></x:Array></Picker.ItemsSource></Picker></VerticalStackLayout><Button Grid.Column="2" Text="Reset" Style="{DynamicResource TertiaryButton}" WidthRequest="66" Clicked="OnResetAccentColor"/></Grid></VerticalStackLayout></Border></VerticalStackLayout>
<VerticalStackLayout Spacing="8"><Button x:Name="SaveButton" Text="Save changes" Style="{DynamicResource PrimaryButton}" Clicked="OnSaveClicked" IsEnabled="{Binding HasChanges}" HeightRequest="52"/><Button x:Name="ResetButton" Text="Reset all settings" Style="{DynamicResource TertiaryButton}" Clicked="OnResetAllClicked" HeightRequest="44"/></VerticalStackLayout>
</VerticalStackLayout></ScrollView></Grid></ContentPage>