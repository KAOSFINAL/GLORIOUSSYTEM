<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.AppSidebar"
             BackgroundColor="{DynamicResource Surface}">
    <Grid Padding="18,20" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                <Label Text="G" FontSize="25" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="GLORIOUSSYTEM" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                <Label Text="LIVING FARM" FontSize="8" CharacterSpacing="1.4" TextColor="{DynamicResource OnSurfaceVariant}" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Margin="0,26,0,18" ColumnDefinitions="Auto,*" ColumnSpacing="9">
            <BoxView WidthRequest="7" HeightRequest="7" BackgroundColor="{DynamicResource StatusOnline}" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="0">
                <Label Text="SYSTEM ONLINE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.1" TextColor="{DynamicResource Primary}" />
                <Label Text="Live monitoring active" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="3">
                <Label Text="WORKSPACE" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.6" TextColor="{DynamicResource OnSurfaceVariant}" Margin="2,0,0,8" />

                <Border x:Name="OverviewItem" Padding="12,13" StrokeThickness="0">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                        <Border x:Name="OverviewIcon" WidthRequest="38" HeightRequest="38" StrokeThickness="0">
                            <Label Text="⌂" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                            <Label Text="OVERVIEW" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Farm health &amp; sensors" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOverviewTapped" /></Border.GestureRecognizers>
                </Border>

                <Border x:Name="ScannerItem" Padding="12,13" StrokeThickness="0">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                        <Border x:Name="ScannerIcon" WidthRequest="38" HeightRequest="38" StrokeThickness="0">
                            <Label Text="✦" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                            <Label Text="WEBCAM" FontSize="13" FontAttributes="Bold" />
                            <Label Text="AI crop intelligence" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnScannerTapped" /></Border.GestureRecognizers>
                </Border>

                <Border x:Name="AnalyticsItem" Padding="12,13" StrokeThickness="0">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                        <Border x:Name="AnalyticsIcon" WidthRequest="38" HeightRequest="38" StrokeThickness="0">
                            <Label Text="⌁" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                            <Label Text="REPORTS" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Trends &amp; history" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAnalyticsTapped" /></Border.GestureRecognizers>
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" Margin="2,20,2,18" />
                <Label Text="SYSTEM" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.6" TextColor="{DynamicResource OnSurfaceVariant}" Margin="2,0,0,8" />

                <Border x:Name="SettingsItem" Padding="12,13" StrokeThickness="0">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                        <Border x:Name="SettingsIcon" WidthRequest="38" HeightRequest="38" StrokeThickness="0">
                            <Label Text="⚙" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                            <Label Text="SETTINGS" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Sensors &amp; appearance" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsTapped" /></Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="3" Spacing="12" Margin="0,18,0,0">
            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Label Text="☀" FontSize="18" TextColor="{DynamicResource Tertiary}" />
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Label Text="SOLAR POWERED" FontSize="9" FontAttributes="Bold" CharacterSpacing=".8" />
                    <Label Text="Energy-aware monitoring" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Grid>
            <Button Text="SIGN OUT" Style="{DynamicResource TertiaryButton}" Clicked="OnLogoutClicked" HeightRequest="38" CornerRadius="0" FontSize="10" TextColor="{DynamicResource Error}" BorderColor="{DynamicResource Error}" BorderWidth="1" />
            <Label Text="GLORIOUSSYTEM • v1.0.0" FontSize="8" HorizontalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
