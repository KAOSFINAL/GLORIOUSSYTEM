<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.AppSidebar"
             BackgroundColor="{DynamicResource Surface}">
    <Grid Padding="18,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <!-- BRAND -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                <Label Text="G" FontSize="22" FontAttributes="Bold" TextColor="White"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="GLORIOUSSYTEM" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                <Label Text="LIVING FARM" FontSize="7" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}" />
            </VerticalStackLayout>
        </Grid>

        <!-- NAVIGATION -->
        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
            <Border x:Name="OverviewItem" Padding="14,9" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
                    <Border x:Name="OverviewIcon" WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                        <Label Text="⌂" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="OVERVIEW" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOverviewTapped" /></Border.GestureRecognizers>
            </Border>

            <Border x:Name="ScannerItem" Padding="14,9" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
                    <Border x:Name="ScannerIcon" WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                        <Label Text="✦" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="WEBCAM" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnScannerTapped" /></Border.GestureRecognizers>
            </Border>

            <Border x:Name="AnalyticsItem" Padding="14,9" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
                    <Border x:Name="AnalyticsIcon" WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                        <Label Text="⌁" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="REPORTS" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAnalyticsTapped" /></Border.GestureRecognizers>
            </Border>

            <Border x:Name="SettingsItem" Padding="14,9" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7">
                    <Border x:Name="SettingsIcon" WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                        <Label Text="⚙" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="SETTINGS" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsTapped" /></Border.GestureRecognizers>
            </Border>
        </HorizontalStackLayout>

        <!-- STATUS / SIGN OUT -->
        <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <BoxView WidthRequest="7" HeightRequest="7" BackgroundColor="{DynamicResource StatusOnline}" VerticalOptions="Center" />
                <Label Text="ONLINE" FontSize="8" FontAttributes="Bold" CharacterSpacing=".8"
                       TextColor="{DynamicResource Primary}" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <Button Text="SIGN OUT" Style="{DynamicResource TertiaryButton}" Clicked="OnLogoutClicked"
                    HeightRequest="32" Padding="12,0" CornerRadius="8" FontSize="8"
                    TextColor="{DynamicResource Error}" BorderColor="{DynamicResource Error}" BorderWidth="1" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
