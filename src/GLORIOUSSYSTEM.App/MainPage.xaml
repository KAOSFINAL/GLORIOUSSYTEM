<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#0F1115}"
             Title="Dashboard">

    <RefreshView x:Name="RefreshView"
                 RefreshColor="{DynamicResource Primary}"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">

        <CollectionView x:Name="SensorList"
                        IsGrouped="True"
                        ItemsLayout="VerticalList"
                        SelectionMode="None"
                        EmptyView="No sensors configured">

            <CollectionView.Header>
                <VerticalStackLayout Padding="24,24,24,14" Spacing="18">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="HYDROPONIC SYSTEM"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.8"
                                   TextColor="{DynamicResource Primary}" />
                            <Label Text="Dashboard"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#151A21, Dark=#F5F7FA}" />
                            <Label Text="Live sensor monitoring and system status"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="46"
                                HeightRequest="46"
                                BackgroundColor="{AppThemeBinding Light=#E8F7F1, Dark=#16352C}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">
                            <Label Text="●"
                                   FontSize="18"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- System status -->
                    <Border Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                            Stroke="{AppThemeBinding Light=#E3E7ED, Dark=#292F38}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{AppThemeBinding Light=#E8F7F1, Dark=#16352C}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="✓"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="System monitoring"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="Sensor data is being monitored"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    Padding="11,6"
                                    BackgroundColor="{DynamicResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                <Label Text="ONLINE"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Overview -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Padding="15"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="SENSORS"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"
                                       TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                                <Label Text="Live readings"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="Monitor environmental data"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="STATUS"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"
                                       TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                                <Label Text="Real-time"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="Automatic monitoring active"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Sensor category -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="24,14,24,8"
                          BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#0F1115}"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Border WidthRequest="38"
                                HeightRequest="38"
                                BackgroundColor="{AppThemeBinding Light=#E8F7F1, Dark=#16352C}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding CategoryIcon}"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding CategoryName}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.1" />
                            <Label Text="{Binding SensorCount, StringFormat='{0} sensors'}"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding OnlineColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasOnline}">
                                <Label Text="{Binding OnlineCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding WarningColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasWarning}">
                                <Label Text="{Binding WarningCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding CriticalColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasCritical}">
                                <Label Text="{Binding CriticalCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Sensor card -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="24,0,24,10"
                            Padding="15"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191D24}"
                            Stroke="{AppThemeBinding Light=#E3E7ED, Dark=#292F38}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="5">

                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    WidthRequest="8"
                                    HeightRequest="44"
                                    BackgroundColor="{Binding StatusColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding SubText}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.RowSpan="2"
                                                 Grid.Column="2"
                                                 Spacing="0"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding ValueText}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{Binding ValueColor}" />
                                <Label Text="{Binding UnitText}"
                                       FontSize="10"
                                       HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}"
                                       IsVisible="{Binding HasUnit}" />
                            </VerticalStackLayout>

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,7,0,0"
                                  IsVisible="{Binding HasThresholds}"
                                  ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding MinThresholdText}"
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" />
                                <ProgressBar Grid.Column="1"
                                             Progress="{Binding ThresholdProgress}"
                                             ProgressColor="{Binding ThresholdProgressColor}"
                                             HeightRequest="5"
                                             VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding MaxThresholdText}"
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light=#697386, Dark=#A8AFBA}"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="24,14,24,32" Spacing="12">
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E3E7ED, Dark=#292F38}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="LAST UPDATED"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light=#7A8494, Dark=#929BA8}" />
                            <Label x:Name="LastUpdatedLabel"
                                   Text="--"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="↻"
                                Style="{DynamicResource PrimaryButton}"
                                CornerRadius="14"
                                WidthRequest="50"
                                HeightRequest="50"
                                FontSize="22"
                                Padding="0"
                                Clicked="OnRefreshClicked"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>
    </RefreshView>
</ContentPage>