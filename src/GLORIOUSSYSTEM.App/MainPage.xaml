<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="#F4F7F5"
             Title="Overview"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="260,*">
        <local:AppSidebar Grid.Column="0" CurrentRoute="dashboard" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="52,42,64,50" Spacing="0">

                <VerticalStackLayout Spacing="3" Margin="0,0,0,48">
                    <Label Text="OVERVIEW" FontSize="11" FontAttributes="Bold" CharacterSpacing="2.5" TextColor="#176B4D" />
                    <Label Text="Hydroponic monitoring" FontSize="40" FontAttributes="Bold" TextColor="#17211D" />
                    <Label Text="A live view of your lettuce growing environment." FontSize="14" TextColor="#60706A" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="1.25*,1*,1*" ColumnSpacing="48" Margin="0,0,0,52">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="FARM HEALTH" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#176B4D" />
                        <Label Text="94" FontSize="54" FontAttributes="Bold" TextColor="#17211D" />
                        <Label Text="GOOD  •  HEALTH SCORE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" TextColor="#176B4D" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="WATER" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#176B4D" />
                        <Label Text="pH 6.2" FontSize="34" FontAttributes="Bold" TextColor="#17211D" />
                        <Label Text="NORMAL  •  WITHIN RANGE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" TextColor="#176B4D" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="3">
                        <Label Text="SOLAR" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#176B4D" />
                        <Label Text="78%" FontSize="34" FontAttributes="Bold" TextColor="#17211D" />
                        <Label Text="BATTERY  •  CHARGING" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" TextColor="#176B4D" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="LIVE SENSOR NETWORK" FontSize="11" FontAttributes="Bold" CharacterSpacing="2" TextColor="#176B4D" />
                        <Label Text="Real-time readings" FontSize="24" FontAttributes="Bold" TextColor="#17211D" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="●  LIVE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="#176B4D" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="64" Margin="0,0,0,48">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="WATER" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#176B4D" Margin="0,0,0,12" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Padding="0,8">
                            <Label Text="pH" FontSize="13" FontAttributes="Bold" TextColor="#17211D" />
                            <Label Grid.Column="1" Text="6.2" FontSize="22" FontAttributes="Bold" TextColor="#17211D" />
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#D3DDD7" Margin="0,7" />
                            <Label Grid.Row="2" Text="EC" FontSize="13" FontAttributes="Bold" TextColor="#17211D" />
                            <Label Grid.Row="2" Grid.Column="1" Text="1.8" FontSize="22" FontAttributes="Bold" TextColor="#17211D" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="0,8">
                            <BoxView Grid.Row="0" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#D3DDD7" Margin="0,0,0,7" />
                            <Label Grid.Row="1" Text="Water Level" FontSize="13" FontAttributes="Bold" TextColor="#17211D" />
                            <Label Grid.Row="1" Grid.Column="1" Text="84%" FontSize="22" FontAttributes="Bold" TextColor="#176B4D" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Text="ENVIRONMENT" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#176B4D" Margin="0,0,0,12" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Padding="0,8">
                            <Label Text="Temperature" FontSize="13" FontAttributes="Bold" TextColor="#17211D" />
                            <Label Grid.Column="1" Text="26.4 °C" FontSize="22" FontAttributes="Bold" TextColor="#17211D" />
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#D3DDD7" Margin="0,7" />
                            <Label Grid.Row="2" Text="Humidity" FontSize="13" FontAttributes="Bold" TextColor="#17211D" />
                            <Label Grid.Row="2" Grid.Column="1" Text="72%" FontSize="22" FontAttributes="Bold" TextColor="#17211D" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="0,8">
                            <BoxView Grid.Row="0" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#D3DDD7" Margin="0,0,0,7" />
                            <Label Grid.Row="1" Text="Air" FontSize="13" FontAttributes="Bold" TextColor="#17211D" />
                            <Label Grid.Row="1" Grid.Column="1" Text="NORMAL" FontSize="12" FontAttributes="Bold" TextColor="#176B4D" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="0" Margin="0,0,0,34">
                    <Label Text="RECENT ACTIVITY" FontSize="11" FontAttributes="Bold" CharacterSpacing="2" TextColor="#176B4D" Margin="0,0,0,14" />
                    <Grid ColumnDefinitions="70,*" Padding="0,8">
                        <Label Text="17:50" FontSize="11" FontAttributes="Bold" TextColor="#60706A" />
                        <Label Grid.Column="1" Text="Sensor network synchronized" FontSize="13" TextColor="#17211D" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#D3DDD7" />
                    <Grid ColumnDefinitions="70,*" Padding="0,8">
                        <Label Text="17:47" FontSize="11" FontAttributes="Bold" TextColor="#60706A" />
                        <Label Grid.Column="1" Text="Water pump activated" FontSize="13" TextColor="#17211D" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#D3DDD7" />
                    <Grid ColumnDefinitions="70,*" Padding="0,8">
                        <Label Text="17:42" FontSize="11" FontAttributes="Bold" TextColor="#60706A" />
                        <Label Grid.Column="1" Text="Environment within limits" FontSize="13" TextColor="#17211D" />
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="LAST SENSOR SYNC" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="#60706A" />
                        <Label x:Name="LastUpdatedLabel" Text="--" FontSize="11" FontAttributes="Bold" TextColor="#17211D" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="REFRESH" Style="{DynamicResource PrimaryButton}" WidthRequest="100" HeightRequest="40" CornerRadius="0" Clicked="OnRefreshClicked" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Hidden data host retained for MainPage.xaml.cs sensor loading and refresh logic. -->
        <RefreshView x:Name="RefreshView" IsVisible="False" Grid.Column="1">
            <CollectionView x:Name="SensorList" />
        </RefreshView>
    </Grid>
</ContentPage>