<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="#160A0C"
             Title="Overview"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="260,*">
        <local:AppSidebar Grid.Column="0" CurrentRoute="dashboard" />

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
            <Grid Padding="42,34,48,18" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="SMART HYDROPONICS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2.2" TextColor="#7A4A55" />
                    <Label Text="Dashboard" FontSize="38" FontFamily="OpenSansSemiBold" TextColor="#FDF0E8" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Stroke="#3A1B22" StrokeThickness="1" BackgroundColor="#211014" StrokeShape="RoundRectangle 21" VerticalOptions="Center">
                    <Label Text="3" FontSize="11" FontAttributes="Bold" TextColor="#F97316" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="42,0,48,24" Padding="20,18" BackgroundColor="#1F0E12" Stroke="#3A1B22" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="FARM STATUS" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#7A4A55" />
                        <Label Text="Healthy environment" FontSize="22" FontAttributes="Bold" TextColor="#FDF0E8" />
                        <HorizontalStackLayout Spacing="7" Margin="0,5,0,0">
                            <Ellipse WidthRequest="7" HeightRequest="7" Fill="#F59E0B" VerticalOptions="Center" />
                            <Label Text="LIVE MONITORING" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.1" TextColor="#F59E0B" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                        <Label Text="28°" FontSize="38" FontAttributes="Bold" TextColor="#FDF0E8" HorizontalTextAlignment="End" />
                        <Label Text="Partly Cloudy" FontSize="10" TextColor="#7A4A55" HorizontalTextAlignment="End" />
                        <Label Text="Green Farm, Nueva Ecija" FontSize="9" TextColor="#7A4A55" HorizontalTextAlignment="End" Margin="0,3,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="42,0,48,16" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="1">
                    <Label Text="SYSTEM OVERVIEW" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="#7A4A55" />
                    <Label Text="Live sensor readings" FontSize="21" FontAttributes="Bold" TextColor="#FDF0E8" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="9:41 AM" FontSize="9" FontAttributes="Bold" TextColor="#F97316" VerticalOptions="End" />
            </Grid>

            <ScrollView Grid.Row="3" Margin="42,0,48,28">
                <VerticalStackLayout Spacing="24">
                    <CollectionView x:Name="SensorList" SelectionMode="None" BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="18" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="18" BackgroundColor="#160A0C" Stroke="#3A1B22" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding CategoryName}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="#7A4A55" />
                                            <Label Grid.Column="1" Text="{Binding SensorCount, StringFormat='{}{0} SENSORS'}" FontSize="8" FontAttributes="Bold" TextColor="#F59E0B" />
                                        </Grid>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,11" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                        <Label Text="{Binding Name}" FontSize="12" TextColor="#FDF0E8" />
                                                        <Label Grid.Column="1" Text="{Binding ValueText}" FontSize="21" FontAttributes="Bold" TextColor="#F59E0B" />
                                                        <Label Grid.Row="1" Text="{Binding SubText}" FontSize="8" TextColor="#7A4A55" />
                                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding UnitText}" FontSize="8" TextColor="#7A4A55" HorizontalTextAlignment="End" />
                                                        <HorizontalStackLayout Grid.Row="2" Spacing="6" VerticalOptions="Center">
                                                            <Ellipse WidthRequest="6" HeightRequest="6" Fill="{Binding StatusColor}" />
                                                            <Label Text="STATUS" FontSize="8" FontAttributes="Bold" CharacterSpacing="1" TextColor="#7A4A55" />
                                                        </HorizontalStackLayout>
                                                        <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#2A1318" Margin="0,10,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <Border Padding="18" BackgroundColor="#1F0E12" Stroke="#3A1B22" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ENVIRONMENT" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="#7A4A55" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="Temperature" FontSize="11" TextColor="#FDF0E8" />
                                    <Label Grid.Column="1" Text="26.5 °C" FontSize="17" FontAttributes="Bold" TextColor="#F59E0B" />
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#3A1B22" Margin="0,8" />
                                    <Label Grid.Row="2" Text="Humidity" FontSize="11" TextColor="#FDF0E8" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="68%" FontSize="17" FontAttributes="Bold" TextColor="#F59E0B" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="18" BackgroundColor="#1F0E12" Stroke="#3A1B22" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="POWER" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="#7A4A55" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="Solar Battery" FontSize="11" TextColor="#FDF0E8" />
                                    <Label Grid.Column="1" Text="85%" FontSize="17" FontAttributes="Bold" TextColor="#F59E0B" />
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#3A1B22" Margin="0,8" />
                                    <Label Grid.Row="2" Text="Status" FontSize="11" TextColor="#FDF0E8" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="Charging" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Padding="18" BackgroundColor="#211014" Stroke="#3A1B22" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#2A1318" StrokeThickness="0" StrokeShape="RoundRectangle 19">
                                <Label Text="✦" FontSize="17" TextColor="#F59E0B" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="CROP HEALTH — HEALTHY" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                <Label Text="CNN Confidence: 92%" FontSize="9" TextColor="#7A4A55" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="92%" FontSize="20" FontAttributes="Bold" TextColor="#F97316" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="LAST SENSOR SYNC" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="#7A4A55" />
                            <Label x:Name="LastUpdatedLabel" Text="--" FontSize="10" FontAttributes="Bold" TextColor="#FDF0E8" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="REFRESH" WidthRequest="96" HeightRequest="38" CornerRadius="19" BackgroundColor="#F59E0B" TextColor="#160A0C" FontSize="9" FontAttributes="Bold" Clicked="OnRefreshClicked" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <RefreshView x:Name="RefreshView" IsVisible="False" Grid.Column="1">
            <CollectionView />
        </RefreshView>
    </Grid>
</ContentPage>