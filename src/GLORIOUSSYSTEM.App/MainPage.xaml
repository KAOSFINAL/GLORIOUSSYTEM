<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="{AppThemeBinding Light={DynamicResource Surface}, Dark={DynamicResource SurfaceDark}}"
             Title="Dashboard">

    <RefreshView x:Name="RefreshView"
                 RefreshColor="{DynamicResource Primary}"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">

        <CollectionView x:Name="SensorList"
                        IsGrouped="True"
                        ItemsLayout="VerticalList"
                        SelectionMode="None"
                        EmptyView="No sensors configured">

            <!-- ===================================================== -->
            <!-- Dashboard Header                                      -->
            <!-- ===================================================== -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,24,20,12" Spacing="18">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="HYDROPONIC SYSTEM"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.8"
                                   TextColor="{DynamicResource Primary}"/>
                            <Label Text="Dashboard"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"/>
                            <Label Text="Live sensor monitoring and system status"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryContainer}, Dark={DynamicResource PrimaryContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                VerticalOptions="Start">
                            <Label Text="●"
                                   FontSize="18"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- System status card -->
                    <Border BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryContainer}, Dark={DynamicResource PrimaryContainerDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="✓"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="System monitoring"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Text="Sensor data is being monitored"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    Padding="10,5"
                                    BackgroundColor="{DynamicResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                <Label Text="ONLINE"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SENSORS"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1" 
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                                <Label Text="Live readings"
                                       FontSize="13"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="STATUS"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                                <Label Text="Real-time"
                                       FontSize="13"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ===================================================== -->
            <!-- Group Header                                            -->
            <!-- ===================================================== -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="20,14,20,8"
                          BackgroundColor="{AppThemeBinding Light={DynamicResource Surface}, Dark={DynamicResource SurfaceDark}}"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Border Grid.Column="0"
                                WidthRequest="38"
                                HeightRequest="38"
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryContainer}, Dark={DynamicResource PrimaryContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding CategoryIcon}"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding CategoryName}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.3"/>
                            <Label Text="{Binding SensorCount, StringFormat='{0} sensors'}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding OnlineColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasOnline}">
                                <Label Text="{Binding OnlineCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Border>
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding WarningColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasWarning}">
                                <Label Text="{Binding WarningCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Border>
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding CriticalColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasCritical}">
                                <Label Text="{Binding CriticalCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- ===================================================== -->
            <!-- Sensor Card                                              -->
            <!-- ===================================================== -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="20,0,20,10"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}"
                            StrokeShape="RoundRectangle 18">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="5">

                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    WidthRequest="10"
                                    HeightRequest="44"
                                    BackgroundColor="{Binding StatusColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding SubText}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.RowSpan="2"
                                                 Grid.Column="2"
                                                 Spacing="0"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding ValueText}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{Binding ValueColor}"/>
                                <Label Text="{Binding UnitText}"
                                       FontSize="10"
                                       HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"
                                       IsVisible="{Binding HasUnit}"/>
                            </VerticalStackLayout>

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,7,0,0"
                                  IsVisible="{Binding HasThresholds}"
                                  ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding MinThresholdText}"
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <ProgressBar Grid.Column="1"
                                             Progress="{Binding ThresholdProgress}"
                                             ProgressColor="{Binding ThresholdProgressColor}"
                                             HeightRequest="5"
                                             VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding MaxThresholdText}"
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ===================================================== -->
            <!-- Footer                                                   -->
            <!-- ===================================================== -->
            <CollectionView.Footer>
                <VerticalStackLayout Padding="20,16,20,32" Spacing="12">
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="LAST UPDATED"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}"/>
                            <Label x:Name="LastUpdatedLabel"
                                   Text="--"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="↻"
                                Style="{DynamicResource PrimaryButton}"
                                CornerRadius="14"
                                WidthRequest="52"
                                HeightRequest="52"
                                FontSize="23"
                                Padding="0"
                                Clicked="OnRefreshClicked"
                                VerticalOptions="Center">
                            <Button.Shadow>
                                <Shadow Brush="{DynamicResource Shadow}"
                                        Radius="10"
                                        Opacity="0.22"
                                        Offset="0,3"/>
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>
    </RefreshView>
</ContentPage>
