<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Overview"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="260,*" BackgroundColor="{DynamicResource Surface}">
        <local:AppSidebar Grid.Column="0" CurrentRoute="dashboard" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="42,34,48,38" Spacing="0">
                <!-- Reference dashboard header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="SMART HYDROPONICS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2.2" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label Text="Dashboard" FontSize="36" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                        <Grid>
                            <Label Text="3" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Secondary}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,9,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Weather / farm strip from reference -->
                <Border Margin="0,0,0,25" Padding="20,17" BackgroundColor="#24140F" Stroke="#4A261D" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="28°C" FontSize="31" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Partly Cloudy" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                                    <Label Text="⌖" FontSize="11" TextColor="{DynamicResource Primary}" />
                                    <Label Text="Green Farm, Nueva Ecija" FontSize="9" CharacterSpacing="0.5" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="3">
                            <Label Text="Humidity 65%" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" />
                            <Label Text="Wind 12 km/h" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" />
                            <Label Text="Rain 20%" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,13">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="SYSTEM OVERVIEW" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label Text="Live sensor readings" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End">
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Primary}" VerticalOptions="Center" />
                        <Label Text="Live" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Dynamic project sensor data, restyled to the reference grid -->
                <Border Padding="0" Margin="0,0,0,22" BackgroundColor="Transparent" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <CollectionView x:Name="SensorList" SelectionMode="None" BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="18,15" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding CategoryIcon}" FontSize="13" VerticalOptions="Center" />
                                            <Label Text="{Binding CategoryName}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding SensorCount, StringFormat='{}{0} SENSORS'}" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <Label Text="{Binding Name}" FontSize="12" TextColor="{DynamicResource OnSurface}" />
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                        <Label Text="{Binding ValueText}" FontSize="20" FontAttributes="Bold" TextColor="{Binding ValueColor}" />
                                                        <Label Text="{Binding UnitText}" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="End" Margin="0,0,0,3" />
                                                    </HorizontalStackLayout>
                                                    <Label Grid.Row="1" Text="{Binding SubText}" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}" />
                                                    <HorizontalStackLayout Grid.Row="2" Spacing="5" Margin="0,6,0,0">
                                                        <Ellipse WidthRequest="5" HeightRequest="5" Fill="{Binding StatusColor}" VerticalOptions="Center" />
                                                        <Label Text="STATUS" FontSize="7" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}" />
                                                    </HorizontalStackLayout>
                                                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,15,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- Reference-style two-column information blocks -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,22">
                    <Border Padding="17" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <VerticalStackLayout Spacing="9">
                            <Label Text="ENVIRONMENT" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,1,Auto">
                                <Label Text="Temperature" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Column="1" Text="26.5 °C" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,8" />
                                <Label Grid.Row="2" Text="Humidity" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="68%" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="17" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                        <VerticalStackLayout Spacing="9">
                            <Label Text="POWER" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,1,Auto">
                                <Label Text="Solar Battery" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Column="1" Text="85%" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,8" />
                                <Label Grid.Row="2" Text="Status" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="Charging" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Padding="16,13" Margin="0,0,0,20" BackgroundColor="#24140F" Stroke="#5A2A18" StrokeThickness="1" StrokeShape="RoundRectangle 4">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Border WidthRequest="38" HeightRequest="38" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 19">
                            <Label Text="✦" FontSize="17" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="CROP HEALTH — HEALTHY" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                            <Label Text="CNN Confidence: 92%" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="92%" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="LAST SENSOR SYNC" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label x:Name="LastUpdatedLabel" Text="--" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="REFRESH" WidthRequest="96" HeightRequest="38" CornerRadius="19" BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" FontSize="9" FontAttributes="Bold" Clicked="OnRefreshClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>