<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.MainPage" BackgroundColor="{DynamicResource Surface}" Title="Overview" Shell.NavBarIsVisible="False">
<Grid RowDefinitions="*,Auto" BackgroundColor="{DynamicResource Surface}">
<RefreshView x:Name="RefreshView" Grid.Row="0" IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}" Command="{Binding RefreshCommand}"><ScrollView><VerticalStackLayout Padding="42,34,48,42" Spacing="0">
<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22"><VerticalStackLayout Spacing="3"><Label Text="Smart Hydroponics System" FontSize="11" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="Dashboard" FontSize="34" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/></VerticalStackLayout><Border Grid.Column="1" WidthRequest="42" HeightRequest="42" BackgroundColor="#331F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 14"><Label Text="♧" FontSize="24" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border></Grid>
<Border Margin="0,0,0,25" Padding="18,16" BackgroundColor="#B31F0E12" Stroke="#665A303A" StrokeThickness="1" StrokeShape="RoundRectangle 18"><VerticalStackLayout Spacing="11"><Grid ColumnDefinitions="*,Auto"><HorizontalStackLayout Spacing="13"><Label Text="28°C" FontSize="30" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><VerticalStackLayout Spacing="2"><Label Text="Partly Cloudy" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="⌖  Green Farm, Nueva Ecija" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></HorizontalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="💧  Humidity 65%" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="〰  Wind 12 km/h" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="☁  Rain 20%" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Grid><Label Text="Today, 9:41 AM" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><Label Text="System Overview" FontSize="10" CharacterSpacing="1.8" TextTransform="Uppercase" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Grid.Column="1" Text="Live ●" FontSize="9" TextColor="{DynamicResource Primary}"/></Grid>
<Border Padding="10" Margin="0,0,0,25" BackgroundColor="#8F1F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 18"><CollectionView x:Name="SensorList" SelectionMode="None" BackgroundColor="Transparent"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><VerticalStackLayout Spacing="7"><Label Text="{Binding CategoryName}" FontSize="9" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}"/><FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding .}" AlignItems="Stretch" JustifyContent="Start"><BindableLayout.ItemTemplate><DataTemplate><Border WidthRequest="190" MinimumHeightRequest="82" Margin="4" Padding="13,11" BackgroundColor="#B32A1318" Stroke="#453A2630" StrokeThickness="1" StrokeShape="RoundRectangle 14"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><Label Text="{Binding Name}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><HorizontalStackLayout Grid.Column="1"><Label Text="{Binding ValueText}" FontSize="18" FontAttributes="Bold" TextColor="{Binding ValueColor}"/><Label Text="{Binding UnitText}" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}" Margin="3,8,0,0"/></HorizontalStackLayout><Label Grid.Row="1" Text="{Binding SubText}" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Grid.Row="2" Text="●  Normal" FontSize="8" TextColor="{Binding StatusColor}" Margin="0,5,0,0"/></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout></VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView></Border>
<Grid ColumnDefinitions="*,*" ColumnSpacing="18" Margin="0,0,0,24"><Border BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="8"><Label Text="ENVIRONMENT" FontSize="9" CharacterSpacing="1.6" TextColor="{DynamicResource OnSurfaceVariant}"/><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,1,Auto" RowSpacing="8"><Label Text="Temperature" FontSize="10" TextColor="{DynamicResource OnSurface}"/><Label Grid.Column="1" Text="26.5 °C" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource OutlineVariant}"/><Label Grid.Row="2" Text="Humidity" FontSize="10" TextColor="{DynamicResource OnSurface}"/><Label Grid.Row="2" Grid.Column="1" Text="68%" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/></Grid></VerticalStackLayout></Border><Border Grid.Column="1" BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="8"><Label Text="POWER" FontSize="9" CharacterSpacing="1.6" TextColor="{DynamicResource OnSurfaceVariant}"/><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,1,Auto" RowSpacing="8"><Label Text="Solar Battery" FontSize="10" TextColor="{DynamicResource OnSurface}"/><Label Grid.Column="1" Text="85%" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource OutlineVariant}"/><Label Grid.Row="2" Text="Status" FontSize="10" TextColor="{DynamicResource OnSurface}"/><Label Grid.Row="2" Grid.Column="1" Text="Charging" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/></Grid></VerticalStackLayout></Border></Grid>
<Border BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,22"><Grid ColumnDefinitions="Auto,*,Auto"><Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PrimaryContainer}" Stroke="#55F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 12"><Label Text="✦" FontSize="16" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Margin="10,0"><Label Text="CNN Predict — Healthy" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="CNN Confidence: 92%" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Label Grid.Column="2" Text="92%" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center"/></Grid></Border>
<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9"><Label Text="Latest Capture" FontSize="9" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Grid.Column="1" Text="Today, 9:30 AM" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}"/></Grid><Border HeightRequest="180" Margin="0,0,0,18" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 18"><Grid><Image Source="https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?w=1000&amp;h=500&amp;fit=crop&amp;auto=format" Aspect="AspectFill"/><Border BackgroundColor="#80100607" StrokeThickness="0" VerticalOptions="End" Padding="13,11"><HorizontalStackLayout><Label Text="● Healthy  · CNN Confidence 92%" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/></HorizontalStackLayout></Border></Grid></Border>
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Last Sensor Sync" FontSize="8" CharacterSpacing="1.1" TextColor="{DynamicResource OnSurfaceVariant}"/><Label x:Name="LastUpdatedLabel" Text="--" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/></VerticalStackLayout><Button Grid.Column="1" Text="REFRESH" WidthRequest="96" HeightRequest="36" CornerRadius="18" BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" FontSize="8" FontAttributes="Bold" Clicked="OnRefreshClicked"/></Grid>
</VerticalStackLayout></ScrollView></RefreshView><local:AppSidebar Grid.Row="1" CurrentRoute="dashboard"/></Grid></ContentPage>