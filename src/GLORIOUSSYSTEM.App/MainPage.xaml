<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Dashboard">

    <RefreshView x:Name="RefreshView" RefreshColor="{DynamicResource Primary}" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView x:Name="SensorList" IsGrouped="True" ItemsLayout="VerticalList" SelectionMode="None" EmptyView="No sensors configured">
            <CollectionView.Header>
                <VerticalStackLayout Padding="24,26,24,10" Spacing="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="OVERVIEW" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource Primary}" />
                            <Label Text="Dashboard" Style="{DynamicResource GSPageTitle}" />
                            <Label Text="Your hydroponic environment at a glance" Style="{DynamicResource GSPageSubtitle}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{DynamicResource GSIconTile}" VerticalOptions="Start">
                            <Label Text="⌁" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="15">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Label Text="✓" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="System online" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource OnPrimaryContainer}" />
                                <Label Text="Live sensor monitoring is active" FontSize="11" TextColor="{DynamicResource OnPrimaryContainer}" Opacity="0.75" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6" VerticalOptions="Center">
                                <Label Text="LIVE" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnPrimary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{DynamicResource SurfaceBright}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="SENSORS" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="Live readings" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Temperature • pH • flow" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceBright}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MONITORING" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="Automatic" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Thresholds are checked" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,3,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Sensor overview" Style="{DynamicResource GSSectionTitle}" />
                            <Label Text="Current values grouped by system category" Style="{DynamicResource GSMuted}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{DynamicResource GSStatusPill}" VerticalOptions="Center">
                            <Label Text="REAL-TIME" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="24,12,24,8" BackgroundColor="{DynamicResource Surface}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                        <Border Style="{DynamicResource GSIconTile}" WidthRequest="38" HeightRequest="38">
                            <Label Text="{Binding CategoryIcon}" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding CategoryName}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.0" />
                            <Label Text="{Binding SensorCount, StringFormat='{0} sensors'}" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                            <Border Padding="8,4" BackgroundColor="{Binding OnlineColor}" StrokeThickness="0" StrokeShape="RoundRectangle 9" IsVisible="{Binding HasOnline}"><Label Text="{Binding OnlineCount}" FontSize="10" FontAttributes="Bold" TextColor="White" /></Border>
                            <Border Padding="8,4" BackgroundColor="{Binding WarningColor}" StrokeThickness="0" StrokeShape="RoundRectangle 9" IsVisible="{Binding HasWarning}"><Label Text="{Binding WarningCount}" FontSize="10" FontAttributes="Bold" TextColor="White" /></Border>
                            <Border Padding="8,4" BackgroundColor="{Binding CriticalColor}" StrokeThickness="0" StrokeShape="RoundRectangle 9" IsVisible="{Binding HasCritical}"><Label Text="{Binding CriticalCount}" FontSize="10" FontAttributes="Bold" TextColor="White" /></Border>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="24,0,24,10" Padding="15" BackgroundColor="{DynamicResource SurfaceBright}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="3">
                            <Border Grid.Row="0" Grid.RowSpan="2" WidthRequest="6" HeightRequest="46" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 3" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding SubText}" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Spacing="0" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding ValueText}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{Binding ValueColor}" />
                                <Label Text="{Binding UnitText}" FontSize="10" HorizontalTextAlignment="End" TextColor="{DynamicResource OnSurfaceVariant}" IsVisible="{Binding HasUnit}" />
                            </VerticalStackLayout>
                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" IsVisible="{Binding HasThresholds}" ColumnDefinitions="Auto,*,Auto">
                                <Label Text="{Binding MinThresholdText}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" Margin="0,0,8,0" />
                                <ProgressBar Grid.Column="1" Progress="{Binding ThresholdProgress}" ProgressColor="{Binding ThresholdProgressColor}" HeightRequest="5" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding MaxThresholdText}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="24,14,24,32" Spacing="12">
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="LAST UPDATED" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Label x:Name="LastUpdatedLabel" Text="--" FontSize="12" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="↻" Style="{DynamicResource PrimaryButton}" CornerRadius="16" WidthRequest="52" HeightRequest="52" FontSize="22" Padding="0" Clicked="OnRefreshClicked" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>