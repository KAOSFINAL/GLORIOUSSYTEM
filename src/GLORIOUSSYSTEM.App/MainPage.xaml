<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Overview"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="260,*" BackgroundColor="{DynamicResource Surface}">
        <local:AppSidebar Grid.Column="0" CurrentRoute="dashboard" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="42,34,48,34" Spacing="0">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="SMART HYDROPONICS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2.2" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label Text="Dashboard" FontSize="36" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 21" VerticalOptions="Center">
                        <Label Text="3" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Farm status / weather banner -->
                <Border Margin="0,0,0,22" Padding="20,18" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="#4A261D" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="FARM STATUS" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Label Text="Healthy environment" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                            <HorizontalStackLayout Spacing="7" Margin="0,5,0,0">
                                <Ellipse WidthRequest="7" HeightRequest="7" Fill="{DynamicResource Primary}" VerticalOptions="Center" />
                                <Label Text="LIVE MONITORING" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.1" TextColor="{DynamicResource Primary}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                            <Label Text="28°" FontSize="38" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="End" />
                            <Label Text="Partly Cloudy" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" />
                            <Label Text="Green Farm, Nueva Ecija" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- System overview -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="SYSTEM OVERVIEW" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label Text="Live sensor readings" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="9:41 AM" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" VerticalOptions="End" />
                </Grid>

                <!-- Sensor data: preserve live bindings from the existing project -->
                <Border Padding="0" Margin="0,0,0,20" BackgroundColor="Transparent" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <CollectionView x:Name="SensorList" SelectionMode="None" BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="16,14" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="7">
                                            <Label Text="{Binding CategoryIcon}" FontSize="13" VerticalOptions="Center" />
                                            <Label Text="{Binding CategoryName}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding SensorCount, StringFormat='{}{0} SENSORS'}" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <Label Text="{Binding Name}" FontSize="12" TextColor="{DynamicResource OnSurface}" />
                                                    <Label Grid.Column="1" Text="{Binding ValueText}" FontSize="21" FontAttributes="Bold" TextColor="{Binding ValueColor}" />
                                                    <Label Grid.Row="1" Text="{Binding SubText}" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}" />
                                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding UnitText}" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" />
                                                    <HorizontalStackLayout Grid.Row="2" Spacing="6" VerticalOptions="Center">
                                                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{Binding StatusColor}" />
                                                        <Label Text="STATUS" FontSize="8" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}" />
                                                    </HorizontalStackLayout>
                                                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,10,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" IsVisible="True" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- Compact environment + power blocks -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,20">
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ENVIRONMENT" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,1,Auto">
                                <Label Text="Temperature" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Column="1" Text="26.5 °C" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,8" />
                                <Label Grid.Row="2" Text="Humidity" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="68%" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="16" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="POWER" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.7" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,1,Auto">
                                <Label Text="Solar Battery" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Column="1" Text="85%" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource OutlineVariant}" Margin="0,8" />
                                <Label Grid.Row="2" Text="Status" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="Charging" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- CNN result strip -->
                <Border Padding="16,13" Margin="0,0,0,20" BackgroundColor="#24140F" Stroke="#5A2A18" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Border WidthRequest="38" HeightRequest="38" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 19">
                            <Label Text="✦" FontSize="17" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="CROP HEALTH — HEALTHY" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                            <Label Text="CNN Confidence: 92%" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="92%" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Existing project refresh functionality -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="LAST SENSOR SYNC" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label x:Name="LastUpdatedLabel" Text="--" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="REFRESH" WidthRequest="96" HeightRequest="38" CornerRadius="19" BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" FontSize="9" FontAttributes="Bold" Clicked="OnRefreshClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <RefreshView x:Name="RefreshView" IsVisible="False" Grid.Column="1">
            <CollectionView />
        </RefreshView>
    </Grid>
</ContentPage>