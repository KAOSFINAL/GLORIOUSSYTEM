<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F7F9FC, Dark=#0D1117}"
             Title="Dashboard">

    <RefreshView x:Name="RefreshView"
                 RefreshColor="{DynamicResource Primary}"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">

        <CollectionView x:Name="SensorList"
                        IsGrouped="True"
                        ItemsLayout="VerticalList"
                        SelectionMode="None"
                        EmptyView="No sensors configured">

            <CollectionView.Header>
                <VerticalStackLayout Padding="22,24,22,12" Spacing="16">

                    <!-- Modern header -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="GLORIOUS SYSTEM"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2"
                                   TextColor="{DynamicResource Primary}" />
                            <Label Text="Dashboard"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}" />
                            <Label Text="Hydroponic environment at a glance"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="{AppThemeBinding Light=#E9F8F1, Dark=#12352A}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                VerticalOptions="Start">
                            <Label Text="⌁"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Live system banner -->
                    <Border Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171C23}"
                            Stroke="{AppThemeBinding Light=#E5EAF0, Dark=#252C35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="{AppThemeBinding Light=#E9F8F1, Dark=#12352A}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13">
                                <Label Text="✓"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="System online"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="Live sensor monitoring is active"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    Padding="11,7"
                                    BackgroundColor="{DynamicResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                <Label Text="LIVE"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Overview cards -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Padding="15"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171C23}"
                                Stroke="{AppThemeBinding Light=#E5EAF0, Dark=#252C35}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="SENSORS"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.3"
                                       TextColor="{AppThemeBinding Light=#7B8492, Dark=#8E99A7}" />
                                <Label Text="Live readings"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Temperature • pH • flow"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171C23}"
                                Stroke="{AppThemeBinding Light=#E5EAF0, Dark=#252C35}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="MONITORING"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.3"
                                       TextColor="{AppThemeBinding Light=#7B8492, Dark=#8E99A7}" />
                                <Label Text="Automatic"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Thresholds are checked"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="SENSOR OVERVIEW"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{AppThemeBinding Light=#7B8492, Dark=#8E99A7}"
                           Margin="2,4,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Sensor category -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="22,12,22,8"
                          BackgroundColor="{AppThemeBinding Light=#F7F9FC, Dark=#0D1117}"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="11">

                        <Border WidthRequest="38"
                                HeightRequest="38"
                                BackgroundColor="{AppThemeBinding Light=#E9F8F1, Dark=#12352A}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding CategoryIcon}"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding CategoryName}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.1" />
                            <Label Text="{Binding SensorCount, StringFormat='{0} sensors'}"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding OnlineColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasOnline}">
                                <Label Text="{Binding OnlineCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding WarningColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasWarning}">
                                <Label Text="{Binding WarningCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                            <Border Padding="8,4"
                                    BackgroundColor="{Binding CriticalColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    IsVisible="{Binding HasCritical}">
                                <Label Text="{Binding CriticalCount}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Sensor card -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="22,0,22,10"
                            Padding="15"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171C23}"
                            Stroke="{AppThemeBinding Light=#E5EAF0, Dark=#252C35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="4">

                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    WidthRequest="7"
                                    HeightRequest="46"
                                    BackgroundColor="{Binding StatusColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding SubText}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.RowSpan="2"
                                                 Grid.Column="2"
                                                 Spacing="0"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding ValueText}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{Binding ValueColor}" />
                                <Label Text="{Binding UnitText}"
                                       FontSize="10"
                                       HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       IsVisible="{Binding HasUnit}" />
                            </VerticalStackLayout>

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,8,0,0"
                                  IsVisible="{Binding HasThresholds}"
                                  ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding MinThresholdText}"
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light=#7B8492, Dark=#8E99A7}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" />
                                <ProgressBar Grid.Column="1"
                                             Progress="{Binding ThresholdProgress}"
                                             ProgressColor="{Binding ThresholdProgressColor}"
                                             HeightRequest="5"
                                             VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding MaxThresholdText}"
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light=#7B8492, Dark=#8E99A7}"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="22,14,22,32" Spacing="14">
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E5EAF0, Dark=#252C35}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="LAST UPDATED"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light=#7B8492, Dark=#8E99A7}" />
                            <Label x:Name="LastUpdatedLabel"
                                   Text="--"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="↻"
                                Style="{DynamicResource PrimaryButton}"
                                CornerRadius="15"
                                WidthRequest="52"
                                HeightRequest="52"
                                FontSize="22"
                                Padding="0"
                                Clicked="OnRefreshClicked"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>
    </RefreshView>
</ContentPage>