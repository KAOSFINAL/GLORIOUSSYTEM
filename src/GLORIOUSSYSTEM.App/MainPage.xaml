<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GLORIOUSSYSTEM.App.MainPage" BackgroundColor="{DynamicResource Surface}" Title="Overview">
    <RefreshView x:Name="RefreshView" RefreshColor="{DynamicResource Primary}" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView x:Name="SensorList" IsGrouped="True" ItemsLayout="VerticalList" SelectionMode="None" EmptyView="No sensors configured">
            <CollectionView.Header>
                <VerticalStackLayout Padding="28,28,28,8" Spacing="20">
                    <!-- Product header -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="SMART HYDROPONIC FARM" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource Primary}" />
                            <Label Text="Good morning, grower." FontSize="30" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                            <Label Text="Here is what your lettuce system is doing right now." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="56" HeightRequest="56" BackgroundColor="{DynamicResource SurfaceBright}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 18" VerticalOptions="Start">
                            <Label Text="☼" FontSize="28" TextColor="{DynamicResource Tertiary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Farm health hero -->
                    <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="22">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="FARM HEALTH" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource Brand200}" />
                                <Label Text="Everything looks stable" FontSize="21" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                                <Label Text="94" FontSize="42" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                                <Label Text="HEALTH SCORE" FontSize="8" CharacterSpacing="1.1" TextColor="{DynamicResource Brand200}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="0.94" ProgressColor="White" BackgroundColor="#FFFFFF35" HeightRequest="7" />
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
                                <Label Text="●  System online" FontSize="11" TextColor="White" />
                                <Label Grid.Column="2" Text="LIVE MONITORING" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Brand200}" HorizontalTextAlignment="End" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- High-value measurements -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto"><Label Text="WATER CHEMISTRY" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.3" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="◌" Grid.Column="1" FontSize="19" TextColor="{DynamicResource Secondary}"/></Grid>
                                <Label Text="pH" FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="7.0" FontSize="30" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                                <Label Text="Optimal range 5.5 – 6.5" FontSize="10" TextColor="{DynamicResource StatusWarning}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto"><Label Text="ENVIRONMENT" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.3" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="⌁" Grid.Column="1" FontSize="19" TextColor="{DynamicResource Primary}"/></Grid>
                                <Label Text="Temperature" FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="24.5°" FontSize="30" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" />
                                <Label Text="Stable • BME280" FontSize="10" TextColor="{DynamicResource StatusOnline}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- System pulse -->
                    <Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="14">
                            <VerticalStackLayout Spacing="2"><Label Text="SYSTEM PULSE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="Your growing environment" FontSize="16" FontAttributes="Bold" /></VerticalStackLayout>
                            <Label Grid.Column="1" Text="24H" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border BackgroundColor="{DynamicResource Brand50}" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12"><VerticalStackLayout Spacing="3"><Label Text="💧" FontSize="18"/><Label Text="Water" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="Active" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/></VerticalStackLayout></Border>
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource AccentBlue50}" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12"><VerticalStackLayout Spacing="3"><Label Text="≋" FontSize="18" TextColor="{DynamicResource Secondary}"/><Label Text="Flow" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="Normal" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/></VerticalStackLayout></Border>
                                <Border Grid.Column="2" BackgroundColor="{DynamicResource AccentAmber50}" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12"><VerticalStackLayout Spacing="3"><Label Text="☀" FontSize="18" TextColor="{DynamicResource Tertiary}"/><Label Text="Solar" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="Charging" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Tertiary}"/></VerticalStackLayout></Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0"><VerticalStackLayout Spacing="2"><Label Text="Live sensor network" FontSize="19" FontAttributes="Bold"/><Label Text="Detailed readings from your farm" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="{DynamicResource Brand50}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,7" VerticalOptions="Center"><Label Text="LIVE" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/></Border></Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="28,16,28,9" BackgroundColor="{DynamicResource Surface}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                        <Border WidthRequest="38" HeightRequest="38" BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 13"><Label Text="{Binding CategoryIcon}" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1"><Label Text="{Binding CategoryName}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/><Label Text="{Binding SensorCount, StringFormat='{0} live sensors'}" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding OnlineCount, StringFormat='{0} online'}" FontSize="9" TextColor="{DynamicResource Primary}" VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="28,0,28,9" Padding="15" BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="13" RowSpacing="3">
                            <Border WidthRequest="5" HeightRequest="43" Grid.RowSpan="2" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 3" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"/><Label Text="{Binding SubText}" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="0"><Label Text="{Binding ValueText}" FontSize="22" FontAttributes="Bold" TextColor="{Binding ValueColor}" HorizontalTextAlignment="End"/><Label Text="{Binding UnitText}" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="End" IsVisible="{Binding HasUnit}"/></VerticalStackLayout>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Progress="{Binding ThresholdProgress}" ProgressColor="{Binding ThresholdProgressColor}" HeightRequest="4" IsVisible="{Binding HasThresholds}" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="28,16,28,34" Spacing="10"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="1"><Label Text="LAST SENSOR SYNC" FontSize="8" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}"/><Label x:Name="LastUpdatedLabel" Text="--" FontSize="12" FontAttributes="Bold"/></VerticalStackLayout><Button Grid.Column="1" Text="↻" Style="{DynamicResource PrimaryButton}" WidthRequest="48" HeightRequest="48" CornerRadius="16" Padding="0" FontSize="20" Clicked="OnRefreshClicked"/></Grid></VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>