<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.LoginPage"
             Title="GLORIOUSSYSTEM"
             BackgroundColor="{DynamicResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" BackgroundColor="{DynamicResource Surface}">
        <Border Grid.Row="0" HeightRequest="285" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,28,28" Padding="0">
            <Grid>
                <Image Source="https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?w=1000&amp;h=500&amp;fit=crop&amp;auto=format" Aspect="AspectFill" />
                <BoxView BackgroundColor="{DynamicResource Surface}" Opacity="0.38" />
                <Grid RowDefinitions="*,Auto" Padding="24,28,24,24">
                    <Border WidthRequest="58" HeightRequest="58" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,14,0,0" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                        <Label Text="◆" FontSize="27" TextColor="{DynamicResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Row="1" Spacing="5" HorizontalOptions="Center">
                        <Label Text="GLORIOUSSYSTEM" FontSize="26" FontAttributes="Bold" CharacterSpacing="1.8" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                        <Label Text="HYDROPONIC MONITORING SYSTEM" FontSize="9" CharacterSpacing="1.8" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout Spacing="7" HorizontalOptions="Center" Margin="0,8,0,0">
                            <Ellipse WidthRequest="7" HeightRequest="7" Fill="{DynamicResource Primary}" VerticalOptions="Center" />
                            <Label Text="SYSTEM ONLINE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.3" TextColor="{DynamicResource OnSurface}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,26,24,32" Spacing="0">
                <Label Text="SECURE ACCESS" FontSize="9" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,10" />
                <Label Text="SIGN IN" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}" Margin="0,0,0,3" />
                <Label Text="Enter your account details to continue." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,25" />
                <VerticalStackLayout Spacing="6" Margin="0,0,0,17">
                    <Label Text="EMAIL" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}" />
                    <Border BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="13,0">
                        <Entry x:Name="EmailEntry" Placeholder="Enter your email" Keyboard="Email" VerticalTextAlignment="Center" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource OnSurfaceVariant}" FontSize="14" TextChanged="OnFieldChanged" ReturnType="Next" Completed="OnEmailCompleted" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" Margin="0,0,0,7">
                    <Label Text="PASSWORD" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurfaceVariant}" />
                    <Border BackgroundColor="{DynamicResource SurfaceContainerHigh}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="13,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="PasswordEntry" Placeholder="Enter your password" IsPassword="{Binding Source={x:Reference ShowPasswordCheckBox}, Path=IsChecked, Converter={StaticResource InverseBoolConverter}}" VerticalTextAlignment="Center" BackgroundColor="Transparent" TextColor="{DynamicResource OnSurface}" PlaceholderColor="{DynamicResource OnSurfaceVariant}" FontSize="14" TextChanged="OnFieldChanged" ReturnType="Done" Completed="OnPasswordCompleted" />
                            <CheckBox x:Name="ShowPasswordCheckBox" Grid.Column="1" Color="{DynamicResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="3">
                            <CheckBox x:Name="RememberMeCheckBox" Color="{DynamicResource Primary}" VerticalOptions="Center" />
                            <Label Text="Remember me" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Forgot password?" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontSize="11" Padding="0" HeightRequest="30" Clicked="OnForgotPasswordClicked" />
                    </Grid>
                </VerticalStackLayout>
                <Label x:Name="ErrorLabel" Text="" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" IsVisible="False" Margin="0,4,0,0" />
                <Button x:Name="LoginButton" Text="SIGN IN" BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" CornerRadius="12" HeightRequest="52" HorizontalOptions="Fill" Margin="0,17,0,18" Clicked="OnLoginClicked" />
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,0,0,14">
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" />
                    <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="{DynamicResource OutlineVariant}" VerticalOptions="Center" />
                </Grid>
                <Button Text="Continue with Google" BackgroundColor="{DynamicResource SurfaceContainer}" TextColor="{DynamicResource OnSurface}" FontSize="12" FontAttributes="Bold" BorderWidth="1" BorderColor="{DynamicResource OutlineVariant}" CornerRadius="12" HeightRequest="50" HorizontalOptions="Fill" />
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" Margin="0,25,0,0">
                    <Label Text="HYDROPONIC LETTUCE MONITORING" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                    <Label Text="Secure access to your sensor system" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                    <Label Text="Demo: admin@glorious.com / password123" FontSize="8" FontAttributes="Italic" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalTextAlignment="Center" Margin="0,3,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>