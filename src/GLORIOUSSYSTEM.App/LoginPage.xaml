<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.LoginPage"
             BackgroundColor="{DynamicResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,34,24,30" RowDefinitions="Auto,Auto,Auto" RowSpacing="22" VerticalOptions="Center">
            <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center">
                <Border WidthRequest="68" HeightRequest="68" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 22" HorizontalOptions="Center">
                    <Label Text="G" FontSize="34" FontAttributes="Bold" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Text="GLORIOUS SYSTEM" FontSize="20" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource OnSurface}" HorizontalOptions="Center" />
                <Label Text="Smart hydroponic monitoring" FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{DynamicResource ElevatedCard}" Padding="26" StrokeShape="RoundRectangle 24" Margin="0">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Welcome back" Style="{DynamicResource HeadlineSmall}" />
                        <Label Text="Sign in to your monitoring dashboard" Style="{DynamicResource GSPageSubtitle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="EMAIL" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Border Style="{DynamicResource GSInput}">
                            <Entry x:Name="EmailEntry" Placeholder="Enter your email" Keyboard="Email" BackgroundColor="Transparent" TextChanged="OnFieldChanged" ReturnType="Next" Completed="OnEmailCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="PASSWORD" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Border Style="{DynamicResource GSInput}">
                            <Entry x:Name="PasswordEntry" Placeholder="Enter your password" IsPassword="{Binding Source={x:Reference ShowPasswordCheckBox}, Path=IsChecked, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" TextChanged="OnFieldChanged" ReturnType="Done" Completed="OnPasswordCompleted" />
                        </Border>
                        <HorizontalStackLayout Spacing="7">
                            <CheckBox x:Name="ShowPasswordCheckBox" Color="{DynamicResource Primary}" />
                            <Label Text="Show password" Style="{DynamicResource BodySmall}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <CheckBox x:Name="RememberMeCheckBox" Color="{DynamicResource Primary}" />
                            <Label Text="Remember me" Style="{DynamicResource BodySmall}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Forgot password?" Style="{DynamicResource TertiaryButton}" Clicked="OnForgotPasswordClicked" Padding="4" HeightRequest="38" FontSize="11" />
                    </Grid>

                    <Label x:Name="ErrorLabel" Text="" FontSize="12" TextColor="{DynamicResource Error}" IsVisible="False" HorizontalOptions="Center" />

                    <Button x:Name="LoginButton" Text="Sign In" Style="{DynamicResource PrimaryButton}" Clicked="OnLoginClicked" IsEnabled="False" HeightRequest="52" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="5" HorizontalOptions="Center">
                <Label Text="HYDROPONIC LETTUCE MONITORING" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.1" TextColor="{DynamicResource Primary}" HorizontalOptions="Center" />
                <Label Text="Secure access to your sensor system" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" HorizontalOptions="Center" />
                <Label Text="Demo: admin@glorious.com / password123" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" FontAttributes="Italic" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>