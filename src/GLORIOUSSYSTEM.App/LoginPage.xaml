<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.LoginPage"
             Title="GLORIOUSSYSTEM"
             BackgroundColor="#F4F7F5"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">

    <Grid ColumnDefinitions="1.05*,1.35*" RowDefinitions="*">

        <!-- BRAND / SYSTEM SIDE -->
        <Grid Grid.Column="0" BackgroundColor="#176B4D" Padding="56,48,48,44">
            <Grid RowDefinitions="Auto,*,Auto">

                <VerticalStackLayout Spacing="4">
                    <Label Text="GLORIOUSSYSTEM"
                           FontSize="25"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="White" />
                    <Label Text="HYDROPONIC MONITORING SYSTEM"
                           FontSize="11"
                           CharacterSpacing="1.5"
                           TextColor="#D5F1E3" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     VerticalOptions="Center"
                                     Spacing="16">
                    <Label Text="SMART FARMING.&#10;MADE VISIBLE."
                           FontSize="38"
                           FontAttributes="Bold"
                           LineHeight="0.95"
                           TextColor="White" />

                    <BoxView HeightRequest="4"
                             WidthRequest="72"
                             HorizontalOptions="Start"
                             Color="#8BE0B4" />

                    <Label Text="Monitor your hydroponic lettuce system,&#10;environment and water conditions&#10;from one place."
                           FontSize="15"
                           LineHeight="1.25"
                           TextColor="#E2F5EA" />

                    <VerticalStackLayout Spacing="3" Margin="0,12,0,0">
                        <Label Text="LETTUCE"
                               FontSize="30"
                               FontAttributes="Bold"
                               CharacterSpacing="3"
                               TextColor="#8BE0B4" />
                        <Label Text="WATER  •  LIGHT  •  AIR"
                               FontSize="9"
                               CharacterSpacing="1"
                               TextColor="#D5F1E3" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Row="2" Spacing="8">
                    <BoxView WidthRequest="9"
                             HeightRequest="9"
                             Color="#8BE0B4"
                             VerticalOptions="Center" />
                    <Label Text="SYSTEM ONLINE"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="1.3"
                           TextColor="White" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- SIGN-IN SIDE -->
        <ScrollView Grid.Column="1">
            <Grid Padding="70,46,90,42"
                  RowDefinitions="Auto,Auto,Auto"
                  VerticalOptions="Center">

                <Label Text="SECURE ACCESS"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       TextColor="#176B4D"
                       Margin="0,0,0,22" />

                <VerticalStackLayout Grid.Row="1"
                                     MaximumWidthRequest="430"
                                     Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="SIGN IN"
                               FontSize="48"
                               FontAttributes="Bold"
                               TextColor="#17211D" />
                        <Label Text="Enter your account details to continue."
                               FontSize="15"
                               TextColor="#60706A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                        <Label Text="EMAIL"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5"
                               TextColor="#34423C" />
                        <Border BackgroundColor="Transparent"
                                Stroke="#AAB8B1"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                HeightRequest="54"
                                Padding="0">
                            <Entry x:Name="EmailEntry"
                                   Placeholder="Enter your email"
                                   Keyboard="Email"
                                   HeightRequest="52"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent"
                                   TextColor="#17211D"
                                   PlaceholderColor="#899790"
                                   FontSize="15"
                                   TextChanged="OnFieldChanged"
                                   ReturnType="Next"
                                   Completed="OnEmailCompleted"
                                   Margin="14,0" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="PASSWORD"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5"
                               TextColor="#34423C" />
                        <Border BackgroundColor="Transparent"
                                Stroke="#AAB8B1"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                HeightRequest="54"
                                Padding="0">
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Enter your password"
                                   IsPassword="{Binding Source={x:Reference ShowPasswordCheckBox}, Path=IsChecked, Converter={StaticResource InverseBoolConverter}}"
                                   HeightRequest="52"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"
                                   BackgroundColor="Transparent"
                                   TextColor="#17211D"
                                   PlaceholderColor="#899790"
                                   FontSize="15"
                                   TextChanged="OnFieldChanged"
                                   ReturnType="Done"
                                   Completed="OnPasswordCompleted"
                                   Margin="14,0" />
                        </Border>

                        <HorizontalStackLayout Spacing="5" HeightRequest="30">
                            <CheckBox x:Name="ShowPasswordCheckBox"
                                      Color="#176B4D"
                                      VerticalOptions="Center" />
                            <Label Text="Show password"
                                   FontSize="12"
                                   TextColor="#60706A"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Margin="0,0,0,2">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <CheckBox x:Name="RememberMeCheckBox"
                                      Color="#176B4D"
                                      VerticalOptions="Center" />
                            <Label Text="Remember me"
                                   FontSize="12"
                                   TextColor="#60706A"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="Forgot password?"
                                BackgroundColor="Transparent"
                                TextColor="#176B4D"
                                FontSize="12"
                                Padding="0"
                                HeightRequest="30"
                                Clicked="OnForgotPasswordClicked" />
                    </Grid>

                    <Label x:Name="ErrorLabel"
                           Text=""
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#C62828"
                           IsVisible="False" />

                    <Button x:Name="LoginButton"
                            Text="SIGN IN   →"
                            BackgroundColor="#176B4D"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            CornerRadius="0"
                            HeightRequest="58"
                            HorizontalOptions="Fill"
                            Margin="0,4,0,0"
                            Clicked="OnLoginClicked"
                            IsEnabled="False" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="2"
                                     Spacing="3"
                                     Margin="0,28,0,0">
                    <Label Text="HYDROPONIC LETTUCE MONITORING"
                           FontSize="9"
                           FontAttributes="Bold"
                           CharacterSpacing="1.4"
                           TextColor="#176B4D" />
                    <Label Text="Secure access to your sensor system"
                           FontSize="10"
                           TextColor="#7A8882" />
                    <Label Text="Demo: admin@glorious.com / password123"
                           FontSize="9"
                           FontAttributes="Italic"
                           TextColor="#9AA59F" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
