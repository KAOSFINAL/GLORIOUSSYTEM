<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GLORIOUSSYSTEM.App.ReportsPage"
             BackgroundColor="{AppThemeBinding Light={DynamicResource Surface}, Dark={DynamicResource SurfaceDark}}"
             Title="Reports">

    <RefreshView RefreshColor="{DynamicResource Primary}"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="20,24,20,36" Spacing="18">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="ANALYTICS"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.8"
                               TextColor="{DynamicResource Primary}" />
                        <Label Text="Reports"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}" />
                        <Label Text="System performance and sensor analytics"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryContainer}, Dark={DynamicResource PrimaryContainerDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            VerticalOptions="Start">
                        <Label Text="▥"
                               FontSize="20"
                               TextColor="{DynamicResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Overview -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Overview"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="SENSORS"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                                <Label x:Name="TotalSensorsLabel"
                                       Text="--"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Primary}" />
                                <Label Text="Total"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="STATUS"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                                <Label x:Name="OnlineSensorsLabel"
                                       Text="--"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource StatusOnline}" />
                                <Label Text="Online"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="ALERTS"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                                <Label x:Name="AlertCountLabel"
                                       Text="--"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource StatusCritical}" />
                                <Label Text="Active"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- pH Analytics -->
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            BackgroundColor="{DynamicResource Primary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            VerticalOptions="Center" />
                                    <Label Text="pH History"
                                           FontSize="19"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label Text="Water acidity trend over time"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Padding="2"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainerHighest}, Dark={DynamicResource SurfaceContainerHighestDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Picker x:Name="ChartTimeRangePicker"
                                        Title="Range"
                                        WidthRequest="112"
                                        FontSize="12"
                                        SelectedIndex="2">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>1 Hour</x:String>
                                            <x:String>6 Hours</x:String>
                                            <x:String>24 Hours</x:String>
                                            <x:String>7 Days</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </Grid>

                        <Border Padding="4"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource Surface}, Dark={DynamicResource SurfaceDark}}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={DynamicResource OutlineVariant}, Dark={DynamicResource OutlineVariantDark}}"
                                StrokeShape="RoundRectangle 17">
                            <GraphicsView x:Name="ReadingsChart"
                                          HeightRequest="290"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Fill"
                                          BackgroundColor="Transparent" />
                        </Border>

                        <HorizontalStackLayout x:Name="ChartLegend"
                                               Spacing="12" />

                        <Grid x:Name="ChartStats"
                              ColumnDefinitions="*,*,*"
                              IsVisible="False"
                              Padding="2,3,2,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="CurrentValueLabel"
                                       Text="--"
                                       FontSize="21"
                                       FontAttributes="Bold" />
                                <Label Text="Current"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="MinValueLabel"
                                       Text="--"
                                       FontSize="21"
                                       FontAttributes="Bold" />
                                <Label Text="Minimum"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label x:Name="MaxValueLabel"
                                       Text="--"
                                       FontSize="21"
                                       FontAttributes="Bold" />
                                <Label Text="Maximum"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- API Connection -->
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource SurfaceContainer}, Dark={DynamicResource SurfaceContainerDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border WidthRequest="38"
                                    HeightRequest="38"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryContainer}, Dark={DynamicResource PrimaryContainerDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11"
                                    VerticalOptions="Center">
                                <Label Text="↔"
                                       FontSize="17"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="API Connection"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Sensor service communication"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                            <Button x:Name="TestApiButton"
                                    Grid.Column="2"
                                    Text="Test"
                                    Style="{DynamicResource PrimaryButton}"
                                    Clicked="OnTestApiClicked"
                                    WidthRequest="76"
                                    HeightRequest="38"
                                    FontSize="13"
                                    Padding="8,0" />
                        </Grid>

                        <Border Padding="11,9"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource Surface}, Dark={DynamicResource SurfaceDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 11">
                            <HorizontalStackLayout Spacing="8">
                                <ActivityIndicator x:Name="ApiTestLoading"
                                                   IsRunning="False"
                                                   IsVisible="False"
                                                   Color="{DynamicResource Primary}"
                                                   WidthRequest="18"
                                                   HeightRequest="18" />
                                <Label x:Name="ApiStatusLabel"
                                       Text="Not tested"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="ApiResultCard"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
                                <Border WidthRequest="28"
                                        HeightRequest="28"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">
                                    <Label x:Name="ApiStatusIconLabel"
                                           FontSize="13"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       x:Name="ApiDetailLabel"
                                       Text="--"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="Latency"
                                       FontSize="10"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={DynamicResource OnSurfaceVariant}, Dark={DynamicResource OnSurfaceVariantDark}}" />
                                <Label Grid.Column="3"
                                       x:Name="ApiLatencyLabel"
                                       Text="-- ms"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label x:Name="ApiErrorLabel"
                               Text=""
                               FontSize="12"
                               TextColor="{DynamicResource Error}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Actions -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Quick Actions"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="10">
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Text="Export Data"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnExportDataClicked"
                                HeightRequest="48" />
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Text="View Logs"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnViewLogsClicked"
                                HeightRequest="48" />
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Text="Calibrate Sensors"
                                Style="{DynamicResource TertiaryButton}"
                                Clicked="OnCalibrateClicked"
                                HeightRequest="48" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="System Info"
                                Style="{DynamicResource TertiaryButton}"
                                Clicked="OnSystemInfoClicked"
                                HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>