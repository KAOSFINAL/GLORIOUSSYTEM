<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GLORIOUSSYSTEM.App"
             x:Class="GLORIOUSSYSTEM.App.ReportsPage"
             BackgroundColor="{DynamicResource Surface}"
             Title="Analytics"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto" BackgroundColor="{DynamicResource Surface}">
        <RefreshView Grid.Row="0"
                     RefreshColor="{DynamicResource Primary}"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="28,30,28,26" Spacing="0">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="REPORTS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2.2"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                            <Label Text="Farm analytics"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource OnSurface}"/>
                            <Label Text="Turn sensor readings into useful growing insights."
                                   FontSize="12"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                Padding="11,8"
                                BackgroundColor="{DynamicResource PrimaryContainer}"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Primary}" VerticalOptions="Center"/>
                                <Label Text="LIVE HISTORY"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="{DynamicResource Primary}"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Summary metrics -->
                    <Grid ColumnDefinitions="*,*,*"
                          Margin="0,0,0,18"
                          ColumnSpacing="1"
                          BackgroundColor="{DynamicResource OutlineVariant}">
                        <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                Padding="16,14"
                                StrokeThickness="0">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="SENSORS" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Label x:Name="TotalSensorsLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/>
                                <Label Text="configured" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="16,14" StrokeThickness="0">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="ONLINE" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource Primary}"/>
                                <Label x:Name="OnlineSensorsLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/>
                                <Label Text="reporting" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="16,14" StrokeThickness="0">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="ALERTS" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource Secondary}"/>
                                <Label x:Name="AlertCountLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/>
                                <Label Text="active" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Chart controls -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="WATER CHEMISTRY"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                            <Label Text="pH trend · live sensor history"
                                   FontSize="11"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="4,1"
                                VerticalOptions="Center">
                            <Picker x:Name="ChartTimeRangePicker"
                                    Title="Range"
                                    WidthRequest="118"
                                    FontSize="10"
                                    SelectedIndex="2"
                                    TextColor="{DynamicResource OnSurface}"
                                    TitleColor="{DynamicResource OnSurfaceVariant}">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>1 Hour</x:String>
                                        <x:String>6 Hours</x:String>
                                        <x:String>24 Hours</x:String>
                                        <x:String>7 Days</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </Grid>

                    <!-- Main chart -->
                    <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                            Stroke="{DynamicResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="17"
                            Margin="0,0,0,18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="pH HISTORY"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1.4"
                                           TextColor="{DynamicResource Primary}"/>
                                    <Label Text="Water chemistry over selected range"
                                           FontSize="10"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{DynamicResource PrimaryContainer}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="9,5">
                                    <Label Text="LIVE"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1"
                                           TextColor="{DynamicResource Primary}"/>
                                </Border>
                            </Grid>

                            <GraphicsView x:Name="ReadingsChart"
                                          HeightRequest="280"
                                          BackgroundColor="{DynamicResource Surface}"/>

                            <HorizontalStackLayout x:Name="ChartLegend" Spacing="14"/>

                            <Grid x:Name="ChartStats"
                                  ColumnDefinitions="*,*,*"
                                  IsVisible="False"
                                  Margin="0,4,0,0">
                                <VerticalStackLayout Spacing="2">
                                    <Label x:Name="CurrentValueLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/>
                                    <Label Text="Current pH" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label x:Name="MinValueLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/>
                                    <Label Text="Minimum" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label x:Name="MaxValueLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/>
                                    <Label Text="Maximum" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lower cards -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,18">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="SYSTEM CONNECTION"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.4"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                            <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                    Stroke="{DynamicResource OutlineVariant}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="15">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Sensor service" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/>
                                            <Label Text="Check communication with the local API." FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/>
                                        </VerticalStackLayout>
                                        <Button x:Name="TestApiButton"
                                                Text="TEST"
                                                Style="{DynamicResource PrimaryButton}"
                                                Clicked="OnTestApiClicked"
                                                WidthRequest="70"
                                                HeightRequest="38"/>
                                    </Grid>
                                    <Border Padding="9"
                                            BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">
                                        <HorizontalStackLayout Spacing="7">
                                            <ActivityIndicator x:Name="ApiTestLoading"
                                                               IsRunning="False"
                                                               IsVisible="False"
                                                               Color="{DynamicResource Primary}"
                                                               WidthRequest="17"
                                                               HeightRequest="17"/>
                                            <Label x:Name="ApiStatusLabel"
                                                   Text="Not tested"
                                                   FontSize="10"
                                                   VerticalOptions="Center"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border x:Name="ApiResultCard"
                                            Padding="9"
                                            StrokeThickness="0"
                                            IsVisible="False"
                                            BackgroundColor="{DynamicResource PrimaryContainer}"
                                            StrokeShape="RoundRectangle 8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                            <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0">
                                                <Label x:Name="ApiStatusIconLabel" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                            </Border>
                                            <Label Grid.Column="1" x:Name="ApiDetailLabel" Text="--" FontSize="10" VerticalOptions="Center" TextColor="{DynamicResource OnSurface}"/>
                                            <Label Grid.Column="2" Text="Latency" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" x:Name="ApiLatencyLabel" Text="-- ms" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/>
                                        </Grid>
                                    </Border>
                                    <Label x:Name="ApiErrorLabel" Text="" FontSize="10" TextColor="{DynamicResource Secondary}" IsVisible="False"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="FARM TIMELINE"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.4"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                            <Border BackgroundColor="{DynamicResource SurfaceContainer}"
                                    Stroke="{DynamicResource OutlineVariant}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="15">
                                <VerticalStackLayout Spacing="11">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Primary}" VerticalOptions="Center"/>
                                        <Label Text="Live sensor sync" FontSize="11" FontAttributes="Bold" Grid.Column="1" TextColor="{DynamicResource OnSurface}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Secondary}" VerticalOptions="Center"/>
                                        <Label Text="Water-quality readings are being collected" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" Grid.Column="1"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Primary}" VerticalOptions="Center"/>
                                        <Label Text="Historical analytics are stored locally" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" Grid.Column="1"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="EXPORT DATA"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnExportDataClicked"
                                HeightRequest="44"/>
                        <Button Text="VIEW SYSTEM LOGS"
                                Grid.Column="1"
                                Style="{DynamicResource TertiaryButton}"
                                Clicked="OnViewLogsClicked"
                                HeightRequest="44"/>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Global bottom navigation -->
        <local:AppSidebar Grid.Row="1" CurrentRoute="reports" />
    </Grid>
</ContentPage>
