<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.ReportsPage" BackgroundColor="{DynamicResource Surface}" Title="Analytics" Shell.NavBarIsVisible="False">
<Grid ColumnDefinitions="260,*">
    <local:AppSidebar Grid.Column="0" CurrentRoute="reports" />
    <RefreshView Grid.Column="1" RefreshColor="{DynamicResource Primary}" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="30,28,36,42" Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3"><Label Text="REPORTS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource Primary}"/><Label Text="Farm analytics" FontSize="32" FontAttributes="Bold"/><Label Text="Turn sensor readings into useful growing insights." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center"><Label Text="24H" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource Primary}"/><Label Text="LIVE HISTORY" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.1" HorizontalTextAlignment="End" TextColor="{DynamicResource StatusOnline}"/></VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="1" BackgroundColor="{DynamicResource OutlineVariant}">
                    <Border BackgroundColor="{DynamicResource SurfaceBright}" Padding="16,14" StrokeThickness="0"><VerticalStackLayout Spacing="3"><Label Text="SENSORS" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><Label x:Name="TotalSensorsLabel" Text="--" FontSize="28" FontAttributes="Bold"/><Label Text="configured" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceBright}" Padding="16,14" StrokeThickness="0"><VerticalStackLayout Spacing="3"><Label Text="ONLINE" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label x:Name="OnlineSensorsLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label Text="reporting" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceBright}" Padding="16,14" StrokeThickness="0"><VerticalStackLayout Spacing="3"><Label Text="ALERTS" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Error}"/><Label x:Name="AlertCountLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Error}"/><Label Text="active" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="1">
                    <Border BackgroundColor="{DynamicResource Primary}" Padding="14,9" StrokeThickness="0"><Label Text="24 HOURS" FontSize="9" FontAttributes="Bold" TextColor="White"/></Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="14,9" StrokeThickness="0"><Label Text="7 DAYS" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/></Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceContainer}" Padding="14,9" StrokeThickness="0"><Label Text="30 DAYS" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}"/></Border>
                    <Label Grid.Column="4" Text="pH TREND" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2" VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}"/>
                </Grid>

                <Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="1" Stroke="{DynamicResource OutlineVariant}" Padding="18">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Water chemistry" FontSize="21" FontAttributes="Bold"/><Label Text="pH trend • live sensor history" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Picker x:Name="ChartTimeRangePicker" Grid.Column="1" Title="Range" WidthRequest="110" FontSize="11" SelectedIndex="2"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>1 Hour</x:String><x:String>6 Hours</x:String><x:String>24 Hours</x:String><x:String>7 Days</x:String></x:Array></Picker.ItemsSource></Picker></Grid>
                        <GraphicsView x:Name="ReadingsChart" HeightRequest="300" BackgroundColor="{DynamicResource SurfaceContainer}"/>
                        <HorizontalStackLayout x:Name="ChartLegend" Spacing="14"/>
                        <Grid x:Name="ChartStats" ColumnDefinitions="*,*,*" IsVisible="False"><VerticalStackLayout><Label x:Name="CurrentValueLabel" Text="--" FontSize="23" FontAttributes="Bold"/><Label Text="Current pH" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label x:Name="MinValueLabel" Text="--" FontSize="23" FontAttributes="Bold"/><Label Text="Minimum" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label x:Name="MaxValueLabel" Text="--" FontSize="23" FontAttributes="Bold"/><Label Text="Maximum" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="SYSTEM CONNECTION" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource Primary}"/>
                        <Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="16">
                            <VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Sensor service" FontSize="17" FontAttributes="Bold"/><Label Text="Check communication with the local API." FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Button x:Name="TestApiButton" Text="TEST" Style="{DynamicResource PrimaryButton}" Clicked="OnTestApiClicked" WidthRequest="78" HeightRequest="40" Padding="8,0" CornerRadius="0"/></Grid><Border Padding="10" BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0"><HorizontalStackLayout Spacing="8"><ActivityIndicator x:Name="ApiTestLoading" IsRunning="False" IsVisible="False" Color="{DynamicResource Primary}" WidthRequest="18" HeightRequest="18"/><Label x:Name="ApiStatusLabel" Text="Not tested" FontSize="11" VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}"/></HorizontalStackLayout></Border><Border x:Name="ApiResultCard" Padding="10" StrokeThickness="0" IsVisible="False"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"><Border WidthRequest="28" HeightRequest="28" StrokeThickness="0"><Label x:Name="ApiStatusIconLabel" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><Label Grid.Column="1" x:Name="ApiDetailLabel" Text="--" FontSize="11" VerticalOptions="Center"/><Label Grid.Column="2" Text="Latency" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center"/><Label Grid.Column="3" x:Name="ApiLatencyLabel" Text="-- ms" FontSize="11" FontAttributes="Bold"/></Grid></Border><Label x:Name="ApiErrorLabel" Text="" FontSize="11" TextColor="{DynamicResource Error}" IsVisible="False"/></VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="9"><Label Text="FARM TIMELINE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource Primary}"/><Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" Padding="16"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><BoxView WidthRequest="6" HeightRequest="6" BackgroundColor="{DynamicResource StatusOnline}" VerticalOptions="Center"/><Label Text="Live sensor sync" FontSize="12" FontAttributes="Bold" Grid.Column="1"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><BoxView WidthRequest="6" HeightRequest="6" BackgroundColor="{DynamicResource Secondary}" VerticalOptions="Center"/><Label Text="Water-quality readings are being collected" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" Grid.Column="1"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><BoxView WidthRequest="6" HeightRequest="6" BackgroundColor="{DynamicResource Primary}" VerticalOptions="Center"/><Label Text="Historical analytics are stored locally" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" Grid.Column="1"/></Grid></VerticalStackLayout></Border></VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="EXPORT DATA" Style="{DynamicResource SecondaryButton}" Clicked="OnExportDataClicked" HeightRequest="46" CornerRadius="0"/><Button Text="VIEW SYSTEM LOGS" Grid.Column="1" Style="{DynamicResource TertiaryButton}" Clicked="OnViewLogsClicked" HeightRequest="46" CornerRadius="0"/></Grid>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</Grid>
</ContentPage>
