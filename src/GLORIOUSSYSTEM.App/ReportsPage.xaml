<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.ReportsPage" BackgroundColor="{DynamicResource Surface}" Title="Analytics" Shell.NavBarIsVisible="False">
<Grid ColumnDefinitions="260,*">
<local:AppSidebar Grid.Column="0" CurrentRoute="reports" />
<RefreshView Grid.Column="1" RefreshColor="{DynamicResource Primary}" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"><ScrollView><VerticalStackLayout Padding="28,30,28,42" Spacing="22">
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="4"><Label Text="FARM ANALYTICS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource Primary}"/><Label Text="See the farm over time" FontSize="32" FontAttributes="Bold"/><Label Text="Turn sensor readings into useful growing insights." FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Border Grid.Column="1" WidthRequest="54" HeightRequest="54" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="↗" FontSize="23" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border></Grid>
<HorizontalStackLayout Spacing="8"><Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13,8"><Label Text="24 hours" FontSize="11" FontAttributes="Bold" TextColor="White"/></Border><Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13,8"><Label Text="7 days" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></Border><Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13,8"><Label Text="30 days" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></Border></HorizontalStackLayout>
<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><Border BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 19" Padding="15"><VerticalStackLayout Spacing="4"><Label Text="SENSORS" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource OnPrimaryContainer}"/><Label x:Name="TotalSensorsLabel" Text="--" FontSize="27" FontAttributes="Bold" TextColor="{DynamicResource OnPrimaryContainer}"/><Label Text="configured" FontSize="10" TextColor="{DynamicResource OnPrimaryContainer}"/></VerticalStackLayout></Border><Border Grid.Column="1" BackgroundColor="{DynamicResource AccentBlue50}" StrokeThickness="0" StrokeShape="RoundRectangle 19" Padding="15"><VerticalStackLayout Spacing="4"><Label Text="ONLINE" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label x:Name="OnlineSensorsLabel" Text="--" FontSize="27" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label Text="reporting" FontSize="10" TextColor="{DynamicResource Secondary}"/></VerticalStackLayout></Border><Border Grid.Column="2" BackgroundColor="{DynamicResource AccentRed50}" StrokeThickness="0" StrokeShape="RoundRectangle 19" Padding="15"><VerticalStackLayout Spacing="4"><Label Text="ALERTS" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource Error}"/><Label x:Name="AlertCountLabel" Text="--" FontSize="27" FontAttributes="Bold" TextColor="{DynamicResource Error}"/><Label Text="active" FontSize="10" TextColor="{DynamicResource Error}"/></VerticalStackLayout></Border></Grid>
<Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="20"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Water chemistry" FontSize="21" FontAttributes="Bold"/><Label Text="pH trend • live sensor history" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3"><Picker x:Name="ChartTimeRangePicker" Title="Range" WidthRequest="105" FontSize="11" SelectedIndex="2"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>1 Hour</x:String><x:String>6 Hours</x:String><x:String>24 Hours</x:String><x:String>7 Days</x:String></x:Array></Picker.ItemsSource></Picker></Border></Grid><Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 19"><GraphicsView x:Name="ReadingsChart" HeightRequest="300" BackgroundColor="Transparent"/></Border><HorizontalStackLayout x:Name="ChartLegend" Spacing="14"/><Grid x:Name="ChartStats" ColumnDefinitions="*,*,*" IsVisible="False"><VerticalStackLayout><Label x:Name="CurrentValueLabel" Text="--" FontSize="23" FontAttributes="Bold"/><Label Text="Current pH" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label x:Name="MinValueLabel" Text="--" FontSize="23" FontAttributes="Bold"/><Label Text="Minimum" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label x:Name="MaxValueLabel" Text="--" FontSize="23" FontAttributes="Bold"/><Label Text="Maximum" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Grid></VerticalStackLayout></Border>
<Border BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 23" Padding="18"><VerticalStackLayout Spacing="13"><Label Text="SYSTEM CONNECTION" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource Primary}"/><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Sensor service" FontSize="17" FontAttributes="Bold"/><Label Text="Check communication with the local API." FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Button x:Name="TestApiButton" Text="Test" Style="{DynamicResource PrimaryButton}" Clicked="OnTestApiClicked" WidthRequest="76" HeightRequest="42" Padding="8,0"/></Grid><Border Padding="12" BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 13"><HorizontalStackLayout Spacing="8"><ActivityIndicator x:Name="ApiTestLoading" IsRunning="False" IsVisible="False" Color="{DynamicResource Primary}" WidthRequest="18" HeightRequest="18"/><Label x:Name="ApiStatusLabel" Text="Not tested" FontSize="12" VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}"/></HorizontalStackLayout></Border><Border x:Name="ApiResultCard" Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 13" IsVisible="False"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8"><Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 8"><Label x:Name="ApiStatusIconLabel" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><Label Grid.Column="1" x:Name="ApiDetailLabel" Text="--" FontSize="12" VerticalOptions="Center"/><Label Grid.Column="2" Text="Latency" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center"/><Label Grid.Column="3" x:Name="ApiLatencyLabel" Text="-- ms" FontSize="12" FontAttributes="Bold"/></Grid></Border><Label x:Name="ApiErrorLabel" Text="" FontSize="12" TextColor="{DynamicResource Error}" IsVisible="False"/></VerticalStackLayout></Border>
<VerticalStackLayout Spacing="10"><Label Text="Farm timeline" FontSize="19" FontAttributes="Bold"/><Border BackgroundColor="{DynamicResource SurfaceBright}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="16"><VerticalStackLayout Spacing="11"><Label Text="●  Live sensor sync" FontSize="12" FontAttributes="Bold"/><Label Text="●  Water-quality readings are being collected" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="●  Historical analytics are stored locally" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border></VerticalStackLayout>
<VerticalStackLayout Spacing="9"><Button Text="Export data" Style="{DynamicResource SecondaryButton}" Clicked="OnExportDataClicked" HeightRequest="48"/><Button Text="View system logs" Style="{DynamicResource TertiaryButton}" Clicked="OnViewLogsClicked" HeightRequest="46"/></VerticalStackLayout>
</VerticalStackLayout></ScrollView></RefreshView>
</Grid>
</ContentPage>