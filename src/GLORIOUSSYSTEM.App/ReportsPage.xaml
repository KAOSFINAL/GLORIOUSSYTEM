<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:GLORIOUSSYSTEM.App" x:Class="GLORIOUSSYSTEM.App.ReportsPage" BackgroundColor="{DynamicResource Surface}" Title="Analytics" Shell.NavBarIsVisible="False">
<Grid RowDefinitions="*,Auto" BackgroundColor="{DynamicResource Surface}"><RefreshView Grid.Row="0" RefreshColor="{DynamicResource Primary}" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"><ScrollView><VerticalStackLayout Padding="28,30,28,26" Spacing="0">
<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24"><VerticalStackLayout Spacing="3"><Label Text="REPORTS" FontSize="10" FontAttributes="Bold" CharacterSpacing="2.2" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="Farm analytics" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Turn sensor readings into useful growing insights." FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Border Grid.Column="1" Padding="11,8" BackgroundColor="#403A2410" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 20" VerticalOptions="Center"><HorizontalStackLayout Spacing="6"><Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Primary}"/><Label Text="LIVE HISTORY" FontSize="8" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource Primary}"/></HorizontalStackLayout></Border></Grid>
<Grid ColumnDefinitions="*,*,*" Margin="0,0,0,18" ColumnSpacing="8"><Border BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="16,14"><VerticalStackLayout><Label Text="SENSORS" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource OnSurfaceVariant}"/><Label x:Name="TotalSensorsLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="configured" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border><Border Grid.Column="1" BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="16,14"><VerticalStackLayout><Label Text="ONLINE" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><Label x:Name="OnlineSensorsLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/><Label Text="reporting" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border><Border Grid.Column="2" BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="16,14"><VerticalStackLayout><Label Text="ALERTS" FontSize="8" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label x:Name="AlertCountLabel" Text="--" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource Secondary}"/><Label Text="active" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border></Grid>
<Border BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="17" Margin="0,0,0,18"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="WATER CHEMISTRY" FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource Primary}"/><Label Text="pH trend · live sensor history" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="#402A1318" Stroke="#453A2630" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="4,1"><Picker x:Name="ChartTimeRangePicker" Title="Range" WidthRequest="118" FontSize="10" SelectedIndex="2" TextColor="{DynamicResource OnSurface}" TitleColor="{DynamicResource OnSurfaceVariant}"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>1 Hour</x:String><x:String>6 Hours</x:String><x:String>24 Hours</x:String><x:String>7 Days</x:String></x:Array></Picker.ItemsSource></Picker></Border></Grid><Border BackgroundColor="#66100607" Stroke="#453A2630" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8"><GraphicsView x:Name="ReadingsChart" HeightRequest="280" BackgroundColor="Transparent"/></Border><HorizontalStackLayout x:Name="ChartLegend" Spacing="14"/><Grid x:Name="ChartStats" ColumnDefinitions="*,*,*" IsVisible="False"><VerticalStackLayout><Label x:Name="CurrentValueLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Current pH" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label x:Name="MinValueLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Minimum" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label x:Name="MaxValueLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Maximum" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Grid></VerticalStackLayout></Border>
<Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,18"><Border BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="10"><Label Text="SYSTEM CONNECTION" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource OnSurfaceVariant}"/><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Sensor service" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="Check communication with the local API." FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout><Button x:Name="TestApiButton" Text="TEST" Style="{DynamicResource PrimaryButton}" Clicked="OnTestApiClicked" WidthRequest="70" HeightRequest="38"/></Grid><Border Padding="9" BackgroundColor="#66100607" Stroke="#453A2630" StrokeThickness="1" StrokeShape="RoundRectangle 9"><HorizontalStackLayout><ActivityIndicator x:Name="ApiTestLoading" IsRunning="False" IsVisible="False" Color="{DynamicResource Primary}"/><Label x:Name="ApiStatusLabel" Text="Not tested" FontSize="10" TextColor="{DynamicResource OnSurfaceVariant}"/></HorizontalStackLayout></Border><Border x:Name="ApiResultCard" Padding="9" BackgroundColor="#403A2410" Stroke="#453A2630" StrokeThickness="1" StrokeShape="RoundRectangle 9" IsVisible="False"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Label x:Name="ApiStatusIconLabel" Grid.Column="0" FontSize="12"/><Label x:Name="ApiDetailLabel" Grid.Column="1" Text="--" FontSize="10" TextColor="{DynamicResource OnSurface}"/><Label Grid.Column="2" Text="Latency" FontSize="8" TextColor="{DynamicResource OnSurfaceVariant}"/><Label x:Name="ApiLatencyLabel" Grid.Column="3" Text="-- ms" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource Primary}"/></Grid></Border><Label x:Name="ApiErrorLabel" Text="" IsVisible="False" FontSize="10" TextColor="{DynamicResource Secondary}"/></VerticalStackLayout></Border><Border Grid.Column="1" BackgroundColor="#A61F0E12" Stroke="#554A2630" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15"><VerticalStackLayout Spacing="11"><Label Text="FARM TIMELINE" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.4" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="●  Live sensor sync" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OnSurface}"/><Label Text="●  Water-quality readings are being collected" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/><Label Text="●  Historical analytics are stored locally" FontSize="9" TextColor="{DynamicResource OnSurfaceVariant}"/></VerticalStackLayout></Border></Grid>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="EXPORT DATA" Style="{DynamicResource SecondaryButton}" Clicked="OnExportDataClicked" HeightRequest="44"/><Button Text="VIEW SYSTEM LOGS" Grid.Column="1" Style="{DynamicResource TertiaryButton}" Clicked="OnViewLogsClicked" HeightRequest="44"/></Grid>
</VerticalStackLayout></ScrollView></RefreshView><local:AppSidebar Grid.Row="1" CurrentRoute="reports"/></Grid></ContentPage>